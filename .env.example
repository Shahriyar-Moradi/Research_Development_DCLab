# Copy to .env and fill in what you use. Nothing here is required to try the product with files only.

# The product's own database (PostgreSQL). Local development, no password, over the local socket:
#   createdb dclab_dev && createdb dclab_test
DCLAB_DATABASE_URL=postgresql+psycopg://YOUR_USER@/dclab_dev
# The database the automated tests may empty and refill. Never point this at data you want to keep.
DCLAB_TEST_DATABASE_URL=postgresql+psycopg://YOUR_USER@/dclab_test

# Models (any OpenAI-compatible endpoint). Without one, every path uses its deterministic fallback.
# Every request goes through the model gateway (dclab_rnd/models); GET /api/models lists the purposes and what each may see.
# The standard tier:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# Other tiers fall back to the standard one. Example: a local model for the cheap purposes (parse patterns, evidence answers):
# DCLAB_TIER_CHEAP_BASE_URL=http://127.0.0.1:11434/v1
# DCLAB_TIER_CHEAP_MODEL=qwen2.5-coder:1.5b
# DCLAB_TIER_STRONG_MODEL=          # the intern and research campaigns (DCLAB_INTERN_MODEL still works)
# DCLAB_TIER_<TIER>_API_KEY=        # when a tier needs its own key
# DCLAB_LOG_PROMPTS=0               # 1 stores prompt text in the usage log (off: prompts can hold the user's words)

# Data sources (credentials stay on the server)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# HF_TOKEN=
# DCLAB_DB_WAREHOUSE=postgresql+psycopg://reader:password@host/db   # a read-only source, named WAREHOUSE in the page

# Privacy: 0 = a file no built-in reader can parse is never sent to a model, even in part
# DCLAB_MODEL_READS_SAMPLE_LINES=1

# Accounts (package 10.2). Unset: one owner on this machine, no sign-in. password or oidc: accounts on (needs PostgreSQL).
# DCLAB_AUTH=password
# DCLAB_COOKIE_SECURE=1             # behind HTTPS: the session cookie is sent over HTTPS only
# The first owner: python -m dclab_rnd.accounts add --email you@example.com --role owner
# Sign-in through the company's identity provider (DCLAB_AUTH=oidc):
# DCLAB_OIDC_ISSUER=https://login.example.com/realms/acme
# DCLAB_OIDC_CLIENT_ID=dclab
# DCLAB_OIDC_CLIENT_SECRET=         # from your secrets store; never committed
# DCLAB_OIDC_ROLES=dclab-owners=owner,ml=data_scientist,risk=reviewer,staff=viewer
# DCLAB_OIDC_GROUPS_CLAIM=groups
# DCLAB_OIDC_REDIRECT=https://dclab.example.com/api/auth/oidc/callback
# DCLAB_SECRET_KEY=                 # a long random value; signs the login's short-lived cookie

# Rate limits and quotas (package 10.6), per person and per workspace, when accounts are on. 0 switches one off.
# DCLAB_LIMIT_REQUESTS_PER_MINUTE=600
# DCLAB_LIMIT_WORKSPACE_REQUESTS_PER_MINUTE=3000
# DCLAB_LIMIT_UPLOAD_MB_PER_DAY=2000
# DCLAB_LIMIT_WORKSPACE_UPLOAD_MB_PER_DAY=10000
# DCLAB_LIMIT_JOBS_PER_USER=4
# DCLAB_LIMIT_JOBS_PER_WORKSPACE=16
# DCLAB_LIMIT_USER_MONTHLY_EUR=25      # model spend a month per person (priced models); the workspace's is DCLAB_WORKSPACE_MONTHLY_EUR

# Where things live (package 12.2: every setting the code reads is listed in this file, with its safe default)
# DCLAB_AGENT_HOME=agent_runs        # the workspace folder (projects, drafts, the intern, logs); in the container: /workspace
# DCLAB_STUDIO_HOME=                 # move only the projects folder (default: <DCLAB_AGENT_HOME>/projects)
# DCLAB_DRAFT_HOME=                  # move only the drafts folder
# DCLAB_INTERN_HOME=                 # move only the intern's sessions
# DCLAB_FILES_URL=                   # s3://bucket/prefix keeps tables and artifacts in a bucket (default: the workspace folder)
# DCLAB_FILES_ENDPOINT=              # an S3-compatible endpoint (MinIO); credentials come from boto3's own chain
# DCLAB_DB_POOL_SIZE=10              # PostgreSQL connections a process keeps open
# DCLAB_DB_MAX_OVERFLOW=20           # and may open beyond them under load
# DCLAB_DB_<NAME>=                   # a read-only data source the Home page can import from (see above: DCLAB_DB_WAREHOUSE)

# The server
# DCLAB_PORT=8765
# DCLAB_ALLOWED_HOSTS=               # host names the server answers to besides 127.0.0.1 and localhost, comma separated (behind a proxy: its name)
# DCLAB_WORKER=inline                # inline: the server also runs jobs; external: only python -m dclab_rnd.worker does (make dev, the containers)
# DCLAB_WORKER_THREADS=4             # jobs one worker runs at a time
# DCLAB_JOB_STALE_SECONDS=120        # a running job whose worker stopped beating this long is marked interrupted
# DCLAB_MCP_PORT=8777                # the standalone MCP server (python -m dclab_rnd.mcp_server)
# DCLAB_ML_PYTHON=.venv/bin/python   # the interpreter the research campaign runs its experiments with

# Models: retries and prices
# DCLAB_LLM_BASE_URL=                # an older name for OPENAI_BASE_URL, still read
# DCLAB_MODEL_RETRIES=2              # attempts after the first, for transient failures only
# DCLAB_MODEL_BACKOFF=1.5            # seconds, doubled after each attempt
# DCLAB_PRICES_FILE=                 # a JSON file of model prices (euros per million tokens), beside dclab_rnd/models/prices.py
# DCLAB_TIER_TUNED_BASE_URL=         # the tuned (policy) model, served only after a reviewer approves it (A6.4)
# DCLAB_TIER_TUNED_MODEL=
# DCLAB_NO_LIVE_MODELS=0             # 1: no request reaches a live model (the tests and the end-to-end flows set it)

# Secrets from files (Docker secrets, a platform's secret store): NAME_FILE=/run/secrets/name sets NAME from that
# file when NAME itself is not set, for any setting above whose name starts with DCLAB_, OPENAI_, HF_, KAGGLE_ or AWS_.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# DCLAB_DATABASE_URL_FILE=/run/secrets/database_url
# The first owner's password for python -m dclab_rnd.accounts add, when not typed at the prompt:
# DCLAB_NEW_PASSWORD=

# Cloud storage and data sources: their own credentials (read by boto3, google-cloud-storage and the Kaggle client)
# AWS_ACCESS_KEY_ID=                 # with AWS_SECRET_ACCESS_KEY (and AWS_SESSION_TOKEN): s3:// imports and DCLAB_FILES_URL
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=                       # or a named profile from AWS_SHARED_CREDENTIALS_FILE (boto3's own setting)
# KAGGLE_CONFIG_DIR=                 # where kaggle.json lives, instead of KAGGLE_USERNAME and KAGGLE_KEY

# The containers (docker-compose.yml)
# DCLAB_DB_PASSWORD=dclab-local-only # the password of the compose file's own PostgreSQL (its port is not published)

# Hugging Face Chat UI beside DCLab (make chat-ui)
# DCLAB_NOTEBOOK_URL=http://127.0.0.1:8765
# DCLAB_CHAT_UI_MODELS=              # the Chat UI's model list, as JSON
# DCLAB_CHAT_UI_EXTRA_ENV=           # more lines for the Chat UI's .env.local

# Logs and metrics (package 12.4)
# DCLAB_LOG_FORMAT=text              # json: one JSON object per line with a request id (the containers set it)
# DCLAB_METRICS_PORT=                # Prometheus counters at /metrics on this port (off when unset); never publish it
# DCLAB_METRICS_HOST=127.0.0.1       # 0.0.0.0 inside a container, so a scraper on its network reaches it
