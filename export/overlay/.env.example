# dclabai settings. `dclab init` writes these for you; copy to .env (or ~/.config/dclabai/.env) to set them by hand.
# Nothing here is required: with no model, every agent runs on its rules.

# --- Your model (pick one) ---------------------------------------------------------------------------------------------
# A local model with Ollama (no key; choose a model with tool calling, for example qwen2.5 or llama3.1):
# DCLAB_LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, vLLM, LM Studio, Together, Groq, ...):
# DCLAB_LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Anthropic Claude:
# DCLAB_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# A cheaper or stronger model for some tasks (optional): DCLAB_TIER_CHEAP_* / DCLAB_TIER_STRONG_* with _BASE_URL, _MODEL, _API_KEY.
# Prices for euro budgets (optional; without them, spend is counted in tokens): DCLAB_PRICES_FILE=prices.json

# --- Where things are kept ------------------------------------------------------------------------------------------------
# DCLAB_AGENT_HOME=~/.dclabai          # projects, drafts, chats, records (local files by default)
# DCLAB_DATABASE_URL=postgresql+psycopg://user@localhost/dclabai   # optional: PostgreSQL (pip install "dclabai[postgres]")

# --- Accounts (optional; needs PostgreSQL) -----------------------------------------------------------------------------
# DCLAB_AUTH=password
