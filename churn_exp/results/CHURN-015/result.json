    "features": [
      {
        "name": "fe_log_tenure",
        "operation": "signed_log",
        "inputs": [
          "tenure"
        ],
        "rationale": "Compress tenure while retaining monotonic customer-age information."
      },
      {
        "name": "fe_total_per_tenure",
        "operation": "ratio",
        "inputs": [
          "TotalCharges",
          "tenure"
        ],
        "rationale": "Approximate realized monthly spend; tenure zero becomes missing and is imputed inside each fold."
      },
      {
        "name": "fe_monthly_x_tenure",
        "operation": "product",
        "inputs": [
          "MonthlyCharges",
          "tenure"
        ],
        "rationale": "Compare billed total with a simple expected cumulative charge."
      },
      {
        "name": "fe_charge_gap",
        "operation": "difference",
        "inputs": [
          "TotalCharges",
          "fe_monthly_x_tenure"
        ],
        "rationale": "Expose billing deviation without using the churn target."
      },
      {
        "name": "fe_log_total",
        "operation": "signed_log",
        "inputs": [
          "TotalCharges"
        ],
        "rationale": "Reduce the long-tailed scale of cumulative charges."
      }
    ],
