# Secrets / local config
.env

# Python environments and caches
.venv/
.venv-agent/
.pytest_cache/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS / editor noise
.DS_Store
*.chat

# Downloaded public datasets (re-fetched with pinned SHA-256 by the expansion campaign)
data/downloads/

# Runtime artifacts
agent_runs/
.chat-ui/
lightning_logs/
.pt_tmp/
tabpfn/results/*.tabpfn_fit
docs/reports/_report_preview.html
sft/runs/

# Trained model files are outputs of the experiment scripts; rerun the script to recreate them
*.joblib
*.ckpt
*.sav
*.pt
tests/.timings*.json
# corpus v4 holds a workspace's projects (A6.2): built by python -m dclab_rnd.studio.corpus_v4, never committed
research/llm-fine-tuning/experiments/sft/out_v4/
backups/

# infrastructure code (12.6): provider downloads, state and real variable values never go to git
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# dclab_core wheel builds (pip wheel ./dclab_core)
dclab_core/build/
dclab_core/*.egg-info/
dclab_core/dist/

# raw session transcripts kept for SFT curation on the owner's machine only: they may hold private data (never committed)
research/llm-fine-tuning/experiments/dev_trajectories/raw/
# generated decision benchmarks (22.1): rebuilt by make decisions-gen; only the manifest (counts, sealed fingerprints) is committed
research/llm-fine-tuning/experiments/decisions/generated_v1/*
!research/llm-fine-tuning/experiments/decisions/generated_v1/MANIFEST.json
# fitted decision classifiers (22.2): rebuilt by make decision-models; the cards (.json) are committed
research/llm-fine-tuning/experiments/decisions/models_v1/*.joblib
# the decision exports (22.5): rebuilt by make decisions-export; the dataset card and the manifest are committed
research/llm-fine-tuning/experiments/decisions/export_v1/*
!research/llm-fine-tuning/experiments/decisions/export_v1/README.md
!research/llm-fine-tuning/experiments/decisions/export_v1/MANIFEST.json
# 25.11: the owner's clone of the testers' records (their sessions and tables)
tester-records/
