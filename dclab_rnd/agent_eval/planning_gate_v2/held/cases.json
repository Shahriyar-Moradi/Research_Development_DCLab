  {
   "id": "hg2_01",
   "stratum": "hidden_late_column",
   "replica": "make_hg2_01",
   "needs_model_planning": true,
   "brief": "Our claims team is drowning. I want the dodgy claims flagged the moment they're filed so the investigators look at the right ones first. Everything is in claims.csv.",
   "tables": {
    "claims.csv": [
     "claim_id",
     "policyholder_id",
     "filed_at",
     "incident_type",
     "claim_amount",
     "policy_age_days",
     "prior_claims_count",
     "channel",
     "investigation_hours",
     "is_fraud"
    ]
   },
   "known_facts": {
    "target": "is_fraud",
    "horizon_days": null,
    "unit": "claim"
   },
   "expected_tasks": [
    "define_target",
    "confirm_prediction_moment",
    "leakage_audit",
    "time_split_check",
    "baseline",
    "capacity_based_metric"
   ],
   "expected_traps": [
    "late_column_neutral_name:investigation_hours",
    "repeat_policyholders",
    "fraud_rate_drifts_over_time",
    "investigator_capacity_not_given"
   ],
   "expected_subproblems": [
    "classification"
   ],
   "forbidden_actions": [
    "use_investigation_hours_as_input",
    "random_split_holdout",
    "judge_by_accuracy_only"
   ],
   "enforceable_traps": [
    {
     "kind": "late_column",
     "column": "investigation_hours",
     "why": "The investigators log their hours only when their review closes, weeks after filing, and fraud reviews run long, so the column gives the answer away."
    },
    {
     "kind": "time_split",
     "column": "filed_at",
     "why": "Claims are flagged as they are filed and the fraud rate drifts over the years, so the holdout must be the latest claims."
    }
   ]
  },
  {
