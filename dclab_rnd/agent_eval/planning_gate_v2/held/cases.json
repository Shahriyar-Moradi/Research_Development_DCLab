   "replica": "make_hg2_02",
   "needs_model_planning": true,
   "brief": "Machines on our lines keep breaking down and maintenance always finds out too late. Can we warn the crew in time? I've attached the sensor readings and the machine list. We are adding about twenty new machines next quarter and want it working on those too.",
   "tables": {
    "readings.csv": [
     "reading_id",
     "machine_id",
     "reading_time",
     "temperature_c",
     "vibration_mm_s",
     "pressure_bar",
     "runtime_hours",
     "previous_failure_count",
     "downtime_minutes",
     "failure_within_7d"
    ],
    "machines.csv": [
     "machine_id",
     "model",
     "site",
     "install_date"
    ]
   },
   "known_facts": {
    "target": null,
    "horizon_days": null,
    "unit": null
   },
   "expected_tasks": [
    "confirm_unit_and_horizon",
    "define_target",
    "ask_owner",
    "check_join_key",
    "leakage_audit",
    "group_split_check"
   ],
   "expected_traps": [
    "missing_horizon",
    "late_column_neutral_name:downtime_minutes",
    "overlapping_label_windows",
    "new_machines_at_deployment",
