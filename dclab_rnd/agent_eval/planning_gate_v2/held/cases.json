   ],
   "expected_subproblems": [
    "classification"
   ],
   "forbidden_actions": [
    "use_downtime_minutes_as_input",
    "drop_previous_failure_count_as_leak",
    "holdout_shares_machines_with_training",
    "assume_horizon_without_check"
   ],
   "enforceable_traps": [
    {
     "kind": "late_column",
     "column": "downtime_minutes",
     "why": "The crew logs downtime for the seven days after each reading, so it is written after the failure it should predict."
    },
    {
     "kind": "group_split",
     "column": "machine_id",
     "why": "Each machine gives about fifty readings that share its own wear and frailty, and the model must work on machines it has never seen."
    }
   ]
