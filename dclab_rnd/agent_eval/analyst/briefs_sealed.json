 {
  "id": "s01",
  "description": "A job board shows each visitor ten listings. We want to rank listings by the chance the visitor applies, scoring each listing when the results page is requested. impressions.csv has one row per listing shown to a visitor; applied is 1 if they applied within the session. Offline we compare models by the area under the ROC curve.",
  "files": {
   "impressions.csv": [
    "impression_id",
    "visitor_id",
    "listing_id",
    "requested_at",
    "position",
    "salary_band",
    "applied",
    "time_on_listing_s"
   ]
