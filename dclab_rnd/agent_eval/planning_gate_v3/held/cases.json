   "id": "hg3_01",
   "stratum": "group_noun_mismatch_with_late",
   "replica": "make_hg3_01",
   "needs_model_planning": true,
   "brief": "We're taking over the farming of several vineyards next season, on land we've never worked. In midsummer I'd like a yield estimate, in tonnes per hectare, for each of those new blocks, so the winery can book its tanks.",
   "tables": {
    "blocks.csv": [
     "parcel_code",
     "vintage",
     "grape_variety",
     "slope_class",
     "area_ha",
     "vine_age_years",
     "winter_rain_mm",
     "frost_damage_pct",
     "clusters_per_vine_sample",
     "bins_delivered",
     "yield_t_per_ha"
    ]
   },
   "known_facts": {
    "target": "yield_t_per_ha",
    "horizon_days": null,
    "unit": "block_vintage"
   },
   "expected_tasks": [
    "define_target",
    "confirm_prediction_moment",
    "leakage_audit",
    "group_split_check",
    "baseline",
    "error_in_business_units"
   ],
   "expected_traps": [
    "late_column_neutral_name:bins_delivered",
    "unseen_parcels_need_grouped_holdout",
    "frost_damage_known_in_spring_is_honest"
   ],
   "expected_subproblems": [
    "regression"
   ],
   "forbidden_actions": [
    "use_bins_delivered_as_input",
    "random_split_holdout_sharing_parcels",
    "drop_frost_damage_as_leak"
   ],
   "enforceable_traps": [
    {
     "kind": "late_column",
     "column": "bins_delivered",
     "why": "The bins are counted off the weighbridge at harvest, after the outcome, and their number is the yield times the area."
    },
    {
     "kind": "group_split",
     "column": "parcel_code",
     "why": "The model must serve blocks the company has never farmed, and each parcel has its own soil, so the holdout must hold parcels never seen in training."
    }
   ]
  },
