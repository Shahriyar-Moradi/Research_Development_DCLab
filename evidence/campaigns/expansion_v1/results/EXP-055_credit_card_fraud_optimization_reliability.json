      "claim_id": "EXP-055-C1",
      "evidence": [
        "evidence.holdout_metrics",
        "evidence.holdout_primary_metric_ci",
        "evidence.holdout_consumed",
        "evidence.cv_selected_metric_mean"
      ],
      "kind": "fact",
      "limitations": [
        "CV models are fitted on part of the training rows while the final model uses all of them, so the holdout can legitimately beat the CV mean; a single holdout is one draw."
      ],
      "statement": "The preselected extra_trees/extra_trees_baseline on the `raw` recipe scored average precision (PR-AUC) 0.8139 on the once-consumed holdout (last 56961 of 284807 rows by `Time`; iid row bootstrap 95% interval 0.7317\u20130.8847); training-CV mean was 0.7858."
    },
    {
      "claim_id": "EXP-055-C2",
      "evidence": [
        "evidence.tuning_decision",
        "evidence.configuration_results",
        "evidence.selection_rule"
      ],
      "kind": "decision",
      "limitations": [
        "Only a handful of explicit candidates were tried; this is a sanity check, not an exhaustive search."
      ],
      "statement": "Tuning rejected: best candidate extra_trees_C01 changed mean training-CV average precision (PR-AUC) by -0.0048 (required \u2265 0.0050), so extra_trees_baseline was used."
    },
    {
      "claim_id": "EXP-055-C3",
      "evidence": [
        "evidence.holdout_metrics",
        "evidence.baselines"
      ],
      "kind": "fact",
      "limitations": [],
      "statement": "Accuracy is uninformative on the holdout: the model's 0.9994 at threshold 0.5 compares with 0.9987 for always predicting 'not fraud', while average precision is 0.8139 vs 0.0013 for a random ranking (ROC-AUC 0.9891)."
    },
    {
      "claim_id": "EXP-055-C4",
      "evidence": [
        "evidence.threshold_analysis"
      ],
      "kind": "decision",
      "limitations": [
        "With only ~75 holdout frauds, precision/recall at a single threshold moves by several points per misclassified case."
      ],
      "statement": "A threshold of 0.2548 chosen on training out-of-fold scores to reach precision \u2265 0.90 (OOF recall 0.750) gives holdout precision 0.963 and recall 0.693 (52 of 75 frauds, 54 alerts); a holdout-chosen (oracle) threshold would reach recall 0.720 at precision \u2265 0.90. Precision at top-100 scores is 0.600."
    },
    {
      "claim_id": "EXP-055-C5",
      "evidence": [
        "evidence.top_final_features",
        "evidence.production_feature_rule"
      ],
      "kind": "recommendation",
      "limitations": [],
      "statement": "Do not promote features from importance alone; require decision-time availability, cross-fold stability, production availability, and monitoring."
    }
  ],
