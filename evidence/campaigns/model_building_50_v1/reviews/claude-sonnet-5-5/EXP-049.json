 "raw_reply": "{\n  \"experiment_id\": \"EXP-049\",\n  \"observed_evidence\": [\n    {\"statement\": \"extra_trees at the ratios stage has the highest mean ROC-AUC (0.8609445343373799) and a fold std of 0.003620327958350225 over 3 folds, 1 repeat.\", \"citation\": \"EXP-049 / evidence.model_results[model=extra_trees].metrics.roc_auc\"},\n    {\"statement\": \"Mean ROC-AUC for the other models: lightgbm 0.8428791965766287, hist_gradient_boosting 0.8385181993978357, xgboost 0.8319355269573551, logistic_regression 0.8054556736414563.\", \"citation\": \"EXP-049 / evidence.model_results[*].metrics.roc_auc.mean\"},\n    {\"statement\": \"extra_trees has a higher per-fold ROC-AUC than lightgbm in all 3 folds (0.8645/0.8572/0.8611 vs 0.8453/0.8382/0.8451).\", \"citation\": \"EXP-049 / evidence.model_results[model=extra_trees|lightgbm].fold_metrics[*].roc_auc\"},\n    {\"statement\": \"The selection rule is mean ROC-AUC minus 0.25×fold std, then runtime, on training CV only.\", \"citation\": \"EXP-049 / evidence.selection_rule\"},\n    {\"statement\": \"All models use optimization 'baseline' with empty model_params, folds=3 and repeats=1.\", \"citation\": \"EXP-049 / evidence.model_results[*].optimization, model_params, folds, repeats\"},\n    {\"statement\": \"extra_trees has the best mean log_loss (0.43802832260054253) and Brier (0.1452041752671764) of the five models. Its mean ece_10 (0.03123074255980239) is lower than the boosters' (0.0661–0.1080) but higher than logistic_regression's (0.025853419879368105).\", \"citation\": \"EXP-049 / evidence.model_results[*].metrics.{log_loss,brier,ece_10}.mean\"},\n    {\"statement\": \"feature_count_mean is 32.333... for every model, and some features have observed_folds=2, so the feature set is not identical across folds.\", \"citation\": \"EXP-049 / evidence.model_results[*].feature_count_mean; evidence.model_results[model=extra_trees].feature_stability[feature=log1p_free_sulfur_dioxide].observed_folds\"},\n    {\"statement\": \"