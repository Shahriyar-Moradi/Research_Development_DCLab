  "claims": [
    {
      "claim_id": "PIT-002-C1",
      "kind": "fact",
      "statement": "On pure noise with random labels, selecting 20 of 2000 features before CV produced ROC-AUC 0.859; doing it inside the folds gave 0.512 (chance is 0.5).",
      "evidence": [
        "evidence.datasets"
      ],
      "limitations": [
        "Univariate filter selection only; wrapper/model-based selection can inflate more."
      ]
    },
    {
      "claim_id": "PIT-002-C2",
      "kind": "fact",
      "statement": "On the real datasets (few features, thousands of rows) the inflation was at most +0.0041.",
      "evidence": [
        "evidence.datasets"
      ],
      "limitations": [
        "Univariate filter selection only; wrapper/model-based selection can inflate more."
      ]
    },
    {
      "claim_id": "PIT-002-C3",
      "kind": "recommendation",
      "statement": "Put feature selection inside the cross-validated pipeline. The danger grows with the number of candidate features relative to rows, so wide data (text, genomics, many engineered features) is where this mistake fabricates results.",
