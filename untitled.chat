,\n+  \"candidate_thresholds = np.linspace(0.05, 0.95, 181)\\n\",\n+  \"threshold_results = []\\n\",\n+  \"for threshold in candidate_thresholds:\\n\",\n+  \"    val_pred = np.where(val_proba >= threshold, 'Yes', 'No')\\n\",\n+  \"    threshold_results.append((\\n\",\n+  \"        threshold,\\n\",\n+  \"        precision_score(y_val, val_pred, pos_label='Yes', zero_division=0),\\n\",\n+  \"        recall_score(y_val, val_pred, pos_label='Yes', zero_division=0),\\n\",\n+  \"    ))\\n\",\n+  \"eligible = [result for result in threshold_results if result[2] >= target_recall]\\n\",\n+  \"decision_threshold, val_precision, val_recall = max(eligible, key=lambda result: result[1])\\n\",\n+  \"\\n\",\n+  \"# Predict and evaluate once on the untouched test set.\\n\",\n+  \"y_proba = pipeline.predict_proba(X_test)[:, 1]\\n\",\n+  \"y_pred = np.where(y_proba >= decision_threshold, 'Yes', 'No')\\n\",\n   \"accuracy = accuracy_score(y_test, y_pred)\\n\",\n+  \"print(f'Validation threshold: {decision_threshold:.2f} '\n+  \"      f'(precision={val_precision:.2f}, recall={val_recall:.2f})')\\n\",\n   \"print(f'Accuracy: {accuracy:.2f}')\\n\",\n   \"\\n\",\n   \"confusion = confusion_matrix(y_test, y_pred)\\n\",\n   \"print('Confusion Matrix:')\\n\",\n@@ -2890,9 +2911,10 @@\n   \"classification_rep = classification_report(y_test, y_pred)\\n\",\n   \"print('Classification Report:')\\n\",\n   \"print(classification_rep)\\n\",\n   \"\\n\",\n-  \"joblib.dump(classifier, MODELS_DIR / 'classifier_model_1.joblib')  # Save the model to 'trai\\n\"\n+  \"model_artifact = {'pipeline': pipeline, 'decision_threshold': decision_threshold}\\n\",\n+  \"joblib.dump(model_artifact, MODELS_DIR / 'classifier_model_1.joblib')\\n\"\n  ]\n },\n {\n  \"cell_type\": \"markdown\",\n",
