{
  "$defs": {
    "Elsewhere": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Case",
          "type": "string"
        },
        "industry": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Industry",
          "type": "string"
        }
      },
      "required": [
        "industry",
        "case"
      ],
      "title": "Elsewhere",
      "type": "object"
    },
    "ExampleSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "research_track",
            "campaign",
            "replica",
            "owner_solution",
            "owner_document",
            "written"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "description": "Where it is: a path, a record id, or the public knowledge it rests on.",
          "maxLength": 600,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "ExampleSource",
      "type": "object"
    },
    "Pattern": {
      "additionalProperties": false,
      "description": "v2: the problem as a general pattern (the owner's problem cards: what was said, the general problem, why it is hard,\nhow to solve it, how to measure it, the common mistakes, the same problem elsewhere).",
      "properties": {
        "elsewhere": {
          "items": {
            "$ref": "#/$defs/Elsewhere"
          },
          "maxItems": 12,
          "title": "Elsewhere",
          "type": "array"
        },
        "general_problem": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The same challenge with the industry's details removed.",
          "title": "General Problem"
        },
        "how_to_measure": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "How To Measure",
          "type": "array"
        },
        "how_to_solve": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "How To Solve",
          "type": "array"
        },
        "mistakes": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Mistakes",
          "type": "array"
        },
        "said": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What was said at the source, without anyone's name.",
          "title": "Said"
        },
        "why_hard": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Why Hard",
          "type": "array"
        }
      },
      "title": "Pattern",
      "type": "object"
    },
    "Practice": {
      "additionalProperties": false,
      "description": "v2: a practice question and what a strong answer names (the metric, the split, the first baseline...).",
      "properties": {
        "names": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Names",
          "type": "array"
        },
        "question": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "Practice",
      "type": "object"
    },
    "RecipeLink": {
      "additionalProperties": false,
      "description": "v2: the task kind and modifiers the problem maps to, and whether DCLab can solve it today.",
      "properties": {
        "capability": {
          "default": "knowledge",
          "enum": [
            "built",
            "planned",
            "knowledge"
          ],
          "title": "Capability",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "modifiers": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Modifiers",
          "type": "array"
        },
        "package": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The plan's package that builds it, when planned.",
          "title": "Package"
        }
      },
      "title": "RecipeLink",
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "maxLength": 80,
          "title": "Metric",
          "type": "string"
        },
        "note": {
          "default": "",
          "description": "The protocol it was measured on, and its limits.",
          "maxLength": 600,
          "title": "Note",
          "type": "string"
        },
        "source": {
          "description": "The record the number comes from.",
          "maxLength": 600,
          "title": "Source",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "source"
      ],
      "title": "Result",
      "type": "object"
    },
    "Understanding": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What is done with a prediction, and what a mistake costs.",
          "title": "Action"
        },
        "family": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "labels": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the outcome is known: every row, a sample of cases, none.",
          "title": "Labels"
        },
        "moment": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the prediction is made, and what is known then.",
          "title": "Moment"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One row: what is predicted for.",
          "title": "Unit"
        }
      },
      "title": "Understanding",
      "type": "object"
    }
  },
  "$id": "https://dclab.dev/schemas/dclab_core.business_example.v2.json",
  "additionalProperties": false,
  "description": "One real problem, as a careful data scientist would write it up for the next one.",
  "properties": {
    "data": {
      "description": "The tables and their important columns, in words (never a value).",
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "title": "Data",
      "type": "array"
    },
    "id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "industry": {
      "default": "",
      "maxLength": 80,
      "title": "Industry",
      "type": "string"
    },
    "pattern": {
      "anyOf": [
        {
          "$ref": "#/$defs/Pattern"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pitfalls": {
      "description": "What goes wrong here: leaks, wrong splits, wrong labels, the trap.",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Pitfalls",
      "type": "array"
    },
    "practice": {
      "items": {
        "$ref": "#/$defs/Practice"
      },
      "maxItems": 20,
      "title": "Practice",
      "type": "array"
    },
    "problem": {
      "description": "The problem in a person's words.",
      "maxLength": 2000,
      "minLength": 1,
      "title": "Problem",
      "type": "string"
    },
    "recipe": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecipeLink"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "replicas": {
      "description": "The replicas that plant its traps.",
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Replicas",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/Result"
      },
      "maxItems": 12,
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": "dclab_core.business_example.v2",
      "default": "dclab_core.business_example.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "solution": {
      "description": "The approach, the split, the metric, the model family, why.",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Solution",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/ExampleSource"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "understanding": {
      "$ref": "#/$defs/Understanding"
    },
    "visibility": {
      "default": "model",
      "description": "v2: rules_only is never put in a model's context.",
      "enum": [
        "model",
        "rules_only"
      ],
      "title": "Visibility",
      "type": "string"
    },
    "workflow": {
      "description": "The steps, in order.",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Workflow",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "problem",
    "source"
  ],
  "title": "BusinessExample",
  "type": "object"
}
