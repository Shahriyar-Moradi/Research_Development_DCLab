            "properties": {
              "quote": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "enum": [
                  "text",
                  "person"
                ]
              }
            },
            "required": [
              "quote",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "inferred"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
