{
  "$defs": {
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "confidential",
            "latency",
            "review_capacity",
            "budget",
            "fairness",
            "regulation",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "reason": {
          "default": "",
          "maxLength": 4000,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "default": "text",
          "enum": [
            "text",
            "data",
            "person",
            "advisor",
            "rule"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "stated",
          "enum": [
            "stated",
            "inferred"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "CoverageFact": {
      "additionalProperties": false,
      "allOf": [
        {
