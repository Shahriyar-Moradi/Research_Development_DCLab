      "type": "string"
    },
    "kind": {
      "enum": [
        "sessions",
        "actions",
        "decisions",
        "conversations",
        "tasks",
        "workflows",
        "fixes",
        "tests",
        "model_requests",
        "agents",
        "teachers",
        "students",
        "audit",
        "deletions",
        "curation",
        "other"
