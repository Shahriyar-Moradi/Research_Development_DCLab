{
  "$id": "https://dclab.dev/schemas/dclab_core.capture_rule.v1.json",
  "additionalProperties": false,
  "description": "One task's rule (v1).",
  "properties": {
    "at_decision": {
      "default": true,
      "title": "At Decision",
      "type": "boolean"
    },
    "confirmed_by": {
      "items": {
        "type": "string"
      },
      "title": "Confirmed By",
      "type": "array"
    },
    "correct_when": {
      "items": {
        "type": "string"
      },
      "title": "Correct When",
      "type": "array"
    },
    "feeds": {
      "items": {
        "enum": [
          "m1_students",
          "m2_workflow_decisions",
          "m3_ml_decisions",
          "m4_workflow_llm",
          "m5_solver_llm",
          "m6_stepwise_decisions",
          "m7_judges",
          "m8_retrieval"
