        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "None When",
      "type": "object"
    },
    "required": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Required",
      "type": "object"
    },
    "schema_version": {
      "const": "dclab_core.capture_rule.v1",
      "default": "dclab_core.capture_rule.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sealed_key": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
