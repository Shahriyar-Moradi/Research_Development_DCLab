  "$id": "https://dclab.dev/schemas/dclab_core.problem_card.v2.json",
  "additionalProperties": false,
  "description": "What problem this is, and whether a project can be built from it yet.\n\nv2 (30.13) adds the fields the owner's framework asks of a problem (the decision and who owns it, what each mistake\ncosts, how many cases a team can act on a period, the success numbers, how the work is done today, the horizon), each\nfilled from the person's answers or left an open field with the person who can answer it. Only the questions that\nchange the solution block (``blocking``, as in v1): ``complete`` says every field is filled or owned (G1).",
  "properties": {
    "baseline_today": {
      "$ref": "#/$defs/TextFact",
      "description": "How the work is done today, and how well."
    },
    "blocking": {
      "description": "Why a project cannot be built yet, in plain words.",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Blocking",
      "type": "array"
    },
    "brief": {
      "$ref": "#/$defs/ProblemBrief"
    },
    "capacity": {
      "$ref": "#/$defs/Capacity"
    },
    "complete": {
      "default": false,
      "description": "G1: nothing blocks, and every field is filled or an open field with its owner.",
      "title": "Complete",
      "type": "boolean"
    },
    "decision": {
      "$ref": "#/$defs/TextFact",
      "description": "The decision each prediction feeds."
    },
    "decision_owner": {
      "$ref": "#/$defs/TextFact",
      "description": "Who owns that decision."
    },
    "error_costs": {
      "$ref": "#/$defs/ErrorCosts"
    },
    "family": {
      "$ref": "#/$defs/FamilyFact"
    },
    "horizon": {
      "$ref": "#/$defs/TextFact",
      "description": "How far ahead each prediction looks (the brief's)."
    },
    "in_play": {
      "description": "The families the words still leave open.",
      "items": {
        "enum": [
          "classification",
          "regression",
          "rare_event",
          "anomaly",
          "forecasting",
          "time_to_event",
          "ranking",
          "segmentation",
          "uplift",
          "entity_tables",
          "streams",
          "text_or_images"
        ],
        "type": "string"
      },
      "title": "In Play",
      "type": "array"
    },
    "labels": {
      "$ref": "#/$defs/LabelsFact"
    },
    "open_fields": {
      "items": {
        "$ref": "#/$defs/OpenField"
      },
      "maxItems": 20,
      "title": "Open Fields",
      "type": "array"
    },
    "outcome": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The outcome: a column, or how the cases are known.",
      "title": "Outcome"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/CardQuestion"
      },
      "maxItems": 20,
      "title": "Questions",
      "type": "array"
    },
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "schema_version": {
      "const": "dclab_core.problem_card.v2",
      "default": "dclab_core.problem_card.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "success": {
      "$ref": "#/$defs/Success"
    }
  },
  "required": [
    "schema_version",
    "brief",
    "family",
    "labels",
    "ready"
  ],
  "title": "ProblemCard",
  "type": "object"
}
