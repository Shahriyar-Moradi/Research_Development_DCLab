    "ProblemBrief": {
      "additionalProperties": false,
      "description": "The problem as understood from its description, before any data is analysed.",
      "properties": {
        "action": {
          "$ref": "#/$defs/TextFact",
          "description": "What is done with each prediction."
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "maxItems": 30,
          "title": "Constraints",
          "type": "array"
        },
        "deliverables": {
          "items": {
            "$ref": "#/$defs/Deliverable"
          },
          "maxItems": 50,
          "title": "Deliverables",
          "type": "array"
        },
        "entities": {
          "$ref": "#/$defs/NamesFact",
          "description": "Columns of the entities rows repeat for (a biker, a subscriber): kept on one side of a split."
        },
        "goal": {
          "$ref": "#/$defs/TextFact",
          "description": "The business objective (ProblemSpec.business_objective)."
        },
        "horizon": {
          "$ref": "#/$defs/TextFact",
          "description": "How far ahead the prediction looks (ProblemSpec.prediction_horizon)."
        },
        "label_coverage": {
          "$ref": "#/$defs/CoverageFact",
          "description": "complete, or partial (a sample: unlabelled is not negative)."
        },
        "label_source": {
          "$ref": "#/$defs/LabelSourceFact",
          "description": "Where labels come from: a column, another file, or none."
        },
        "open_questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "maxItems": 20,
          "title": "Open Questions",
          "type": "array"
        },
        "prediction_moment": {
          "$ref": "#/$defs/TextFact",
          "description": "When the prediction is made and what is known then."
        },
        "primary_metric": {
          "$ref": "#/$defs/TextFact",
          "description": "The metric the description names, if any (ProblemSpec.primary_metric)."
        },
        "schema_version": {
          "const": "dclab_core.problem_brief.v1",
          "default": "dclab_core.problem_brief.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the description and file headers it was built from",
          "title": "Source Digest"
        },
        "success_criteria": {
          "items": {
            "$ref": "#/$defs/TextFact"
          },
          "maxItems": 20,
          "title": "Success Criteria",
          "type": "array"
        },
        "target_column": {
          "$ref": "#/$defs/TextFact",
          "description": "The column holding the label, when there is one (ProblemSpec.target_column)."
        },
        "target_definition": {
          "$ref": "#/$defs/TextFact",
          "description": "How the label is defined when no column holds it, e.g. 'listed in known_frauds.csv'."
        },
        "task": {
          "$ref": "#/$defs/TaskFact",
          "description": "binary, multiclass or regression (ProblemSpec.task_type)."
        },
        "time_column": {
          "$ref": "#/$defs/TextFact",
          "description": "The column saying when each row is predicted (ProblemSpec.prediction_time_column)."
        },
        "unit": {
          "$ref": "#/$defs/TextFact",
          "description": "What one scored row is: a ride, a customer-month, a ticket (ProblemSpec.prediction_unit)."
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "ProblemBrief",
      "type": "object"
    },
