            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        }
      },
      "title": "Choice",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "One ratio's two tables over one period, checked at the grain they share (the day and every dimension both hold): a key where the\nnumerator is positive and the denominator has no row or reads zero, or where the denominator is positive and the numerator's table has\nno row, is a gap. A key with no row in either table is a closed day, not a gap.",
      "properties": {
        "days": {
          "title": "Days",
          "type": "integer"
        },
        "denominator": {
          "title": "Denominator",
          "type": "string"
        },
        "grain": {
          "items": {
            "type": "string"
          },
          "title": "Grain",
          "type": "array"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "numerator": {
          "title": "Numerator",
          "type": "string"
        },
        "numerator_missing": {
          "items": {
            "type": "string"
          },
