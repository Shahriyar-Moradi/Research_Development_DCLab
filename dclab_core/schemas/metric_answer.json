            "type": "string"
          },
          "maxItems": 10,
          "title": "Assumed",
          "type": "array"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Missing",
          "type": "array"
        },
        "notes": {
