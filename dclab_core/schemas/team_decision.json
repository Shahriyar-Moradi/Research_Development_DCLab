{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Who did something: an agent (by its configuration's name), a team, or a person (by their id).",
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "agent",
            "team",
            "person"
          ],
          "title": "Kind",
          "type": "string"
        },
        "team": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*(:[A-Za-z0-9_.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The team the actor belongs to or represents.",
          "title": "Team"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "title": "When",
          "type": "string"
        },
        "who": {
          "$ref": "#/$defs/Actor",
          "description": "The person who approved: always the decision owner."
        }
      },
      "required": [
        "who",
        "when"
      ],
      "title": "Approval",
      "type": "object"
    }
  },
  "$id": "https://dclab.dev/schemas/dclab_core.team_decision.v2.json",
  "additionalProperties": false,
  "description": "The decision owner's choice, the evidence and constraints it rested on, and what happened after.\n\nv2 (0.169.0) adds what a host needs to keep one honest record of it: ``revision`` (each accepted write is the next\none, so a person who read an older one is told), ``request_id`` (the same request sent twice is one write),\n``supersedes`` (the earlier decision this one replaces: an approved decision is never edited), who measured the\noutcome, when and on which measure, and the policy it was approved under. A v1 decision reads as revision 1.",
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Approval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "constraint_revisions": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Constraint Revisions",
      "type": "array"
    },
    "decision_owner": {
      "$ref": "#/$defs/Actor",
      "description": "The person who decides."
    },
    "evidence_revisions": {
      "description": "Report ids it rested on.",
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Evidence Revisions",
      "type": "array"
    },
    "follow_up_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Follow Up Date"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
      "title": "Id",
      "type": "string"
    },
    "option": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Option",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "outcome_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "v2: when the outcome was observed.",
      "title": "Outcome At"
    },
    "outcome_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/Actor"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "v2: who recorded the outcome."
    },
    "outcome_measure": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "v2: the measure the outcome was read on, by its name (renewed_within_30_days): a name, never a sentence.",
      "title": "Outcome Measure"
    },
    "policy_ref": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "v2: the policy the decision was approved under, by reference (policy:renewal-outreach@v2): a reference, never its words.",
      "title": "Policy Ref"
    },
    "problem_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
      "title": "Problem Id",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "v2: the request that made this write; the same request again is the same write.",
      "title": "Request Id"
    },
    "revision": {
      "default": 1,
      "description": "v2: which accepted write of this decision this is, from 1.",
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "dclab_core.team_decision.v2",
      "default": "dclab_core.team_decision.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "simulated_follow_up": {
      "default": false,
      "title": "Simulated Follow Up",
      "type": "boolean"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "v2: the earlier decision this one replaces.",
      "title": "Supersedes"
    }
  },
  "required": [
    "schema_version",
    "id",
    "problem_id",
    "decision_owner",
    "option"
  ],
  "title": "TeamDecision",
  "type": "object"
}
