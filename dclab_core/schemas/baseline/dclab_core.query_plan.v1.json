{
  "$defs": {
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "maxLength": 200,
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "gt",
            "ge",
            "lt",
            "le",
            "between",
            "is_null",
            "not_null"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "column",
        "op"
      ],
      "type": "object"
    },
    "Measure": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "maxLength": 80,
          "type": "string"
        },
        "op": {
          "enum": [
            "count",
            "count_distinct",
            "sum",
            "mean",
            "median",
            "min",
            "max",
            "rate",
            "percentile"
          ],
          "type": "string"
        },
        "q": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "where": {
          "anyOf": [
            {
              "$ref": "#/$defs/Filter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "op"
      ],
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "maxLength": 200,
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grain": {
          "default": "month",
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ],
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "column"
      ],
      "type": "object"
    },
    "Sort": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "maxLength": 200,
          "type": "string"
        },
        "desc": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "by"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "filters": {
      "items": {
        "$ref": "#/$defs/Filter"
      },
      "type": "array"
    },
    "group_by": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limit": {
      "default": 50,
      "minimum": 1,
      "type": "integer"
    },
    "measures": {
      "items": {
        "$ref": "#/$defs/Measure"
      },
      "type": "array"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/Period"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "dclab_core.query_plan.v1",
      "default": "dclab_core.query_plan.v1",
      "type": "string"
    },
    "sort": {
      "items": {
        "$ref": "#/$defs/Sort"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "type": "object"
}
