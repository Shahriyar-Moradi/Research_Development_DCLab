{
  "$defs": {
    "CardEdit": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 40,
          "type": "string"
        },
        "field": {
          "maxLength": 60,
          "type": "string"
        },
        "value": {
          "maxLength": 600,
          "type": "string"
        },
        "why": {
          "maxLength": 600,
          "type": "string"
        }
      },
      "required": [
        "field",
        "value",
        "why",
        "code"
      ],
      "type": "object"
    },
    "ColumnCard": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "enum": [
            "constant",
            "binary",
            "low",
            "medium",
            "high",
            "very_high"
          ],
          "type": "string"
        },
        "categories": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "date_format": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "digits": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "distinct": {
          "minimum": 0,
          "type": "integer"
        },
        "dtype": {
          "enum": [
            "integer",
            "float",
            "boolean",
            "datetime",
            "string",
            "categorical",
            "other"
          ],
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "integer": {
          "default": false,
          "type": "boolean"
        },
        "known_at_prediction": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "monotonic": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "null_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "nulls": {
          "enum": [
            "none",
            "under_1pct",
            "from_1_to_10pct",
            "from_10_to_50pct",
            "from_50_to_90pct",
            "from_90_to_99pct",
            "over_99pct",
            "all"
          ],
          "type": "string"
        },
        "numeric_levels": {
          "default": false,
          "type": "boolean"
        },
        "prefix": {
          "anyOf": [
            {
              "maxLength": 6,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "identifier",
                "time",
                "entity",
                "target_candidate",
                "feature",
                "text",
                "place",
                "constant",
                "leak_suspect"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantiles": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 7,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repeats": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "enum": [
            "numeric",
            "categorical_code",
            "identifier",
            "datetime",
            "free_text",
            "other"
          ],
          "type": "string"
        },
        "sensitivity": {
          "anyOf": [
            {
              "enum": [
                "restricted",
                "pii",
                "sensitive",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sensitivity_why": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shape": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shares": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 51,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "step": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "uniqueness": {
          "enum": [
            "none",
            "under_1pct",
            "from_1_to_10pct",
            "from_10_to_50pct",
            "from_50_to_90pct",
            "from_90_to_99pct",
            "over_99pct",
            "all"
          ],
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_pattern": {
          "enum": [
            "digits",
            "mixed",
            "date_like",
            "long_text",
            "short_text",
            "not_text"
          ],
          "type": "string"
        },
        "why": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "dtype",
        "role",
        "nulls",
        "uniqueness",
        "cardinality",
        "value_pattern",
        "null_rate",
        "distinct"
      ],
      "type": "object"
    },
    "DetectedModifier": {
      "additionalProperties": false,
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "asks_user": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "maxLength": 60,
          "type": "string"
        },
        "reason": {
          "maxLength": 600,
          "type": "string"
        },
        "strength": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "applies",
        "reason",
        "strength"
      ],
      "type": "object"
    },
    "FitVerdict": {
      "additionalProperties": false,
      "properties": {
        "back_to": {
          "anyOf": [
            {
              "enum": [
                "problem",
                "data"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/CardEdit"
          },
          "maxItems": 12,
          "type": "array"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "schema_version": {
          "const": "dclab_core.fit_verdict.v1",
          "default": "dclab_core.fit_verdict.v1",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "fits",
            "fits_with_changes",
            "does_not_fit"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "verdict"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z_]{3,60}$",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "numbers": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "source": {
          "default": "found",
          "enum": [
            "found",
            "planted"
          ],
          "type": "string"
        },
        "statement": {
          "maxLength": 400,
          "type": "string"
        },
        "tables": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        }
      },
      "required": [
        "code",
        "statement"
      ],
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "concentrated_on": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entities": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fanout": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "key",
            "join",
            "disjoint",
            "agrees",
            "equals",
            "null_when",
            "one_to_one"
          ],
          "type": "string"
        },
        "matched": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "other_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "other_table": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "table": {
          "maxLength": 200,
          "type": "string"
        },
        "unmatched": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "table",
        "columns"
      ],
      "type": "object"
    },
    "TableCard": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnCard"
          },
          "maxItems": 2000,
          "type": "array"
        },
        "duplicate_rows": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grain": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "joins_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        },
        "key": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "default": "main",
          "enum": [
            "main",
            "labels",
            "related"
          ],
          "type": "string"
        },
        "rows": {
          "minimum": 0,
          "type": "integer"
        },
        "target_candidates": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "name",
        "rows"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "detected_modifiers": {
      "items": {
        "$ref": "#/$defs/DetectedModifier"
      },
      "maxItems": 12,
      "type": "array"
    },
    "fit": {
      "anyOf": [
        {
          "$ref": "#/$defs/FitVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limits": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "problems": {
      "items": {
        "$ref": "#/$defs/Problem"
      },
      "maxItems": 100,
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "maxItems": 500,
      "type": "array"
    },
    "schema_version": {
      "const": "dclab_core.data_card.v4",
      "default": "dclab_core.data_card.v4",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "type": "boolean"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/TableCard"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "target": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "name",
    "tables"
  ],
  "type": "object"
}
