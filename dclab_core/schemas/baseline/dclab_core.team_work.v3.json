        "team": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*(:[A-Za-z0-9_.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "string"
