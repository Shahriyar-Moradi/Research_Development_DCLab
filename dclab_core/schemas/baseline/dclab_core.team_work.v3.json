        "status": {
          "enum": [
            "planned",
            "running",
            "denied",
            "timed_out",
            "succeeded",
            "failed",
            "skipped",
            "simulated"
          ],
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "action",
        "actor",
        "status"
      ],
      "type": "object"
    },
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
