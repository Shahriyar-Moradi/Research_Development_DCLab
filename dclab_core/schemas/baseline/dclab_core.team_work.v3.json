{
  "$defs": {
    "ActionLine": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^[a-z][a-z0-9_]*(:[A-Za-z0-9_.-]+)?$",
          "type": "string"
        },
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
          "type": "string"
        },
        "actor": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ref": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
