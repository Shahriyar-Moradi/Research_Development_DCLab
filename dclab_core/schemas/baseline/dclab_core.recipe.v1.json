{
  "$defs": {
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "maxLength": 200,
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "gt",
            "ge",
            "lt",
            "le",
            "between",
            "is_null",
            "not_null"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "column",
        "op"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "agg": {
          "default": "sum",
          "enum": [
            "sum",
            "mean",
            "count",
            "min",
            "max",
            "median"
          ],
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "type": "array"
        },
        "desc": {
          "default": false,
          "type": "boolean"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "maxItems": 20,
          "type": "array"
        },
        "how": {
          "default": "left",
          "enum": [
            "left",
            "inner"
          ],
          "type": "string"
        },
        "index": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "kind": {
          "enum": [
            "rename",
            "drop_columns",
            "filter",
            "dedupe",
            "to_date",
            "drop_missing",
            "sort",
            "months_since",
            "join",
            "pivot"
          ],
          "type": "string"
        },
        "spread": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "table": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "to": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "why": {
          "default": "",
          "maxLength": 400,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "dclab_core.recipe.v1",
      "default": "dclab_core.recipe.v1",
      "type": "string"
    },
    "source_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 100,
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "type": "object"
}
