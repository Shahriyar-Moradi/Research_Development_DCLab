{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "consent": {
          "enum": [
            "owner",
            "train",
            "improve",
            "public",
            "ours"
          ],
          "type": "string"
        },
        "group": {
          "maxLength": 200,
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "enum": [
            "construction",
            "replica",
            "factory_rule",
            "rule_prod",
            "human_exposed",
            "human_blind",
            "measured_outcome",
            "public_catalog",
            "verified_synthetic",
            "research_record",
            "dev_record",
            "teacher_claude"
          ],
          "type": "string"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "source": {
          "maxLength": 200,
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "dev",
            "sealed",
            "eval_only"
          ],
          "type": "string"
        }
      },
      "required": [
        "source",
        "origin",
        "consent",
        "group",
        "split"
      ],
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "construction",
            "reproduced",
            "executed",
            "cited",
            "label_match",
            "person",
            "none"
          ],
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "passed"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "example_id": {
      "maxLength": 80,
      "type": "string"
    },
    "family": {
      "enum": [
        "understand_problem",
        "ask_question",
        "read_data",
        "eda_plan",
        "leakage_judgment",
        "split_design",
        "problem_type",
        "algorithm_choice",
        "feature_plan",
        "evaluation_design",
        "pipeline_code",
        "read_results",
        "next_experiment",
        "report",
        "agent_step",
        "typed_decision",
        "evidence_answer",
        "engineering",
        "solution_design"
      ],
      "type": "string"
    },
    "messages": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "maxItems": 60,
      "minItems": 2,
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "quality": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "dclab_core.training_example.v1",
      "default": "dclab_core.training_example.v1",
      "type": "string"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    }
  },
  "required": [
    "schema_version",
    "example_id",
    "family",
    "messages",
    "verification",
    "provenance"
  ],
  "type": "object"
}
