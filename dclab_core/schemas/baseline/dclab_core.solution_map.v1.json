{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "approach": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "defers": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        },
        "family": {
          "maxLength": 40,
          "type": "string"
        },
        "final": {
          "enum": [
            "own",
            "deferred"
          ],
          "type": "string"
        },
        "id": {
          "pattern": "^blk\\d+$",
          "type": "string"
        },
        "part": {
          "pattern": "^part\\d+$",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/SplitDesign"
        },
        "sub_problem": {
          "pattern": "^sp\\d+$",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workflow": {
          "$ref": "#/$defs/SolutionWorkflow"
        }
      },
      "required": [
        "id",
        "part",
        "sub_problem",
        "title",
        "family",
        "workflow",
        "split",
        "final"
      ],
      "type": "object"
    },
    "HoldoutDesign": {
      "additionalProperties": false,
      "properties": {
        "chosen_on": {
          "const": "validation",
          "default": "validation",
          "type": "string"
        },
        "read_by": {
          "enum": [
            "leaf",
            "composition"
          ],
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/SplitDesign"
        },
        "step": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "split",
        "read_by"
      ],
      "type": "object"
    },
    "SolutionStep": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "type": "array"
        },
        "joins": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "sequence",
            "fusion",
            "gate",
            "budget",
            "score"
          ],
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 600,
          "type": "string"
        },
        "output": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "reads_holdout": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "output"
      ],
      "type": "object"
    },
    "SolutionWorkflow": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "maxLength": 40,
          "type": "string"
        },
        "findings_used": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "type": "array"
        },
        "problems": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "schema_version": {
          "const": "dclab_core.solution_workflow.v1",
          "default": "dclab_core.solution_workflow.v1",
          "type": "string"
        },
        "source": {
          "default": "template",
          "enum": [
            "template",
            "model"
          ],
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 60,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "family"
      ],
      "type": "object"
    },
    "SplitDesign": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        },
        "moment": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "share": {
          "default": 0.2,
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "strategy": {
          "enum": [
            "stratified",
            "time",
            "group",
            "time_group"
          ],
          "type": "string"
        }
      },
      "required": [
        "strategy"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "type": "string"
        },
        "check": {
          "maxLength": 400,
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "type": "array"
        },
        "decision": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gate": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{1,60}$",
          "type": "string"
        },
        "inputs": {
          "items": {
            "enum": [
              "table",
              "label file",
              "training rows",
              "holdout",
              "findings",
              "columns kept",
              "chosen model",
              "approval",
              "holdout score",
              "report"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "kind": {
          "default": "family",
          "enum": [
            "safety",
            "family",
            "card",
            "finding"
          ],
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "type": "string"
        },
        "outputs": {
          "items": {
            "enum": [
              "table",
              "label file",
              "training rows",
              "holdout",
              "findings",
              "columns kept",
              "chosen model",
              "approval",
              "holdout score",
              "report"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "purpose": {
          "maxLength": 400,
          "type": "string"
        },
        "rests_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "type": "array"
        },
        "rule": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "required": [
        "id",
        "block",
        "name",
        "purpose",
        "check",
        "rule"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
    },
    "fingerprint": {
      "default": "",
      "maxLength": 64,
      "type": "string"
    },
    "holdout": {
      "$ref": "#/$defs/HoldoutDesign"
    },
    "map": {
      "maxLength": 64,
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "type": "array"
    },
    "schema_version": {
      "const": "dclab_core.solution_map.v1",
      "default": "dclab_core.solution_map.v1",
      "type": "string"
    },
    "source": {
      "default": "rules",
      "enum": [
        "rules",
        "model",
        "person"
      ],
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/SolutionStep"
      },
      "maxItems": 40,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "map",
    "blocks",
    "holdout"
  ],
  "type": "object"
}
