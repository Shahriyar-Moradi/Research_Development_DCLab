{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consent": {
          "default": "operate",
          "enum": [
            "operate",
            "improve",
            "train"
          ],
          "type": "string"
        },
        "deleted": {
          "default": false,
          "type": "boolean"
        },
        "draft": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entry": {
          "maxLength": 200,
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source": {
          "maxLength": 4000,
          "type": "string"
        },
        "workspace": {
          "maxLength": 120,
          "type": "string"
        }
      },
      "required": [
        "entry",
        "sha256",
        "source",
        "workspace",
        "at"
      ],
      "type": "object"
    },
    "RoutingReading": {
      "additionalProperties": false,
      "properties": {
        "answerer": {
          "maxLength": 120,
          "type": "string"
        },
        "by": {
          "enum": [
            "rule",
            "model",
            "own_model",
            "person"
          ],
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "no_thinking": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shadow": {
          "default": false,
          "type": "boolean"
        },
        "thinking": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thinking_source": {
          "anyOf": [
            {
              "const": "recorded",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "used": {
          "default": false,
          "type": "boolean"
        },
        "value": {
          "default": null
        }
      },
      "required": [
        "by",
        "answerer"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "exam": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "maxLength": 200,
      "type": "string"
    },
    "label": {
      "default": null
    },
    "label_by": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "label_source": {
      "anyOf": [
        {
          "enum": [
            "real",
            "written",
            "silver"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "en",
            "fa",
            "mixed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_type": {
      "const": "m7_routing",
      "default": "m7_routing",
      "type": "string"
    },
    "more": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "type": "array"
    },
    "no_text": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "options": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "origin": {
      "enum": [
        "real",
        "scripted",
        "written",
        "eval"
      ],
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "point": {
      "maxLength": 120,
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "readings": {
      "items": {
        "$ref": "#/$defs/RoutingReading"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "dclab_core.routing_example.v1",
      "default": "dclab_core.routing_example.v1",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "sealed"
      ],
      "type": "string"
    },
    "split_group": {
      "maxLength": 200,
      "type": "string"
    },
    "state": {
      "additionalProperties": true,
      "type": "object"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 8000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "used_by": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "value_used": {
      "default": null
    },
    "weight": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "id",
    "split",
    "provenance",
    "point",
    "origin",
    "split_group"
  ],
  "type": "object"
}
