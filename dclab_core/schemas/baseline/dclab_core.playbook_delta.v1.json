{
  "$defs": {
    "Bullet": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "maxLength": 120,
          "type": "string"
        },
        "codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "harmful": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "helpful": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "pattern": "^B-[0-9a-f]{10}$",
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "shown": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "probed",
            "accepted",
            "retired"
          ],
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 10,
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "scope",
        "evidence",
        "by"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "type": "string"
        },
        "grader": {
          "maxLength": 40,
          "type": "string"
        },
        "pack": {
          "maxLength": 80,
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "step": {
          "maxLength": 80,
          "type": "string"
        }
      },
      "required": [
        "pack",
        "step",
        "code",
        "grader"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "at": {
      "type": "string"
    },
    "bullet": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bullet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "by": {
      "maxLength": 120,
      "type": "string"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    "family": {
      "maxLength": 40,
      "type": "string"
    },
    "lineage": {
      "maxLength": 40,
      "type": "string"
    },
    "op": {
      "enum": [
        "add",
        "count",
        "status",
        "retire"
      ],
      "type": "string"
    },
    "reason": {
      "maxLength": 600,
      "minLength": 3,
      "type": "string"
    },
    "schema_version": {
      "const": "dclab_core.playbook_delta.v1",
      "default": "dclab_core.playbook_delta.v1",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "draft",
            "probed",
            "accepted",
            "retired"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target": {
      "anyOf": [
        {
          "pattern": "^B-[0-9a-f]{10}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "family",
    "lineage",
    "op",
    "by",
    "reason",
    "at"
  ],
  "type": "object"
}
