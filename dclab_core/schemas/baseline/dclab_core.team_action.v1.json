{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "agent",
            "team",
            "person"
          ],
          "type": "string"
        },
        "team": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*(:[A-Za-z0-9_.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "pattern": "^[a-z][a-z0-9_]*(:[A-Za-z0-9_.-]+)?$",
      "type": "string"
    },
    "action_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_ref": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_revision": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "output_ref": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "responded_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/Actor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retry_key": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "dclab_core.team_action.v1",
      "default": "dclab_core.team_action.v1",
      "type": "string"
    },
    "source": {
      "pattern": "^(tool|human):[A-Za-z0-9_.:@-]+$",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "running",
        "denied",
        "timed_out",
        "succeeded",
        "failed",
        "skipped",
        "simulated"
      ],
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "action_id",
    "actor",
    "action",
    "source",
    "input_revision",
    "retry_key"
  ],
  "type": "object"
}
