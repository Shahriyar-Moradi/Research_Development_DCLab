{
  "$defs": {
    "Bullet": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "maxLength": 120,
          "type": "string"
        },
        "codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "harmful": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "helpful": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "pattern": "^B-[0-9a-f]{10}$",
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "shown": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "probed",
            "accepted",
            "retired"
          ],
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 10,
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "scope",
        "evidence",
        "by"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "type": "string"
        },
        "grader": {
          "maxLength": 40,
          "type": "string"
        },
        "pack": {
          "maxLength": 80,
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "step": {
          "maxLength": 80,
          "type": "string"
        }
      },
      "required": [
        "pack",
        "step",
        "code",
        "grader"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bullets": {
      "items": {
        "$ref": "#/$defs/Bullet"
      },
      "type": "array"
    },
    "family": {
      "maxLength": 40,
      "type": "string"
    },
    "lineage": {
      "maxLength": 40,
      "type": "string"
    },
    "schema_version": {
      "const": "dclab_core.playbook.v1",
      "default": "dclab_core.playbook.v1",
      "type": "string"
    },
    "version": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "family",
    "lineage"
  ],
  "type": "object"
}
