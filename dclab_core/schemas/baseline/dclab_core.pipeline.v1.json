{
  "$defs": {
    "PipelineStep": {
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "fingerprint": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        "kind": {
          "enum": [
            "problem",
            "data",
            "solution",
            "workflow",
            "analysis",
            "stage",
            "report"
          ],
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "numbers": {
          "items": {
            "type": "string"
          },
          "maxItems": 2000,
          "type": "array"
        },
        "outputs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        "record": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rerun": {
          "default": "none",
          "enum": [
            "replay",
            "rerun",
            "none"
          ],
          "type": "string"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "run": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "done",
            "stale",
            "failed",
            "not_run",
            "not_recorded"
          ],
          "type": "string"
        },
        "why": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "status"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "dclab_core.pipeline.v1",
      "default": "dclab_core.pipeline.v1",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PipelineStep"
      },
      "maxItems": 60,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "steps"
  ],
  "type": "object"
}
