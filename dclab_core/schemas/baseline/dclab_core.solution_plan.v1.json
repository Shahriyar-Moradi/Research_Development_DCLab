{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "$ref": "#/$defs/JsonValue"
        },
        "why_not": {
          "maxLength": 4000,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "choice",
        "why_not"
      ],
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "maxItems": 8,
          "type": "array"
        },
        "choice": {
          "$ref": "#/$defs/JsonValue"
        },
        "cites": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "key": {
          "maxLength": 80,
          "pattern": "^[a-z_]+(\\.[a-z_]+)*$",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 10,
          "type": "string"
        },
        "schema_version": {
          "const": "dclab_core.decision.v1",
          "default": "dclab_core.decision.v1",
          "type": "string"
        },
        "source": {
          "default": "rule",
          "enum": [
            "text",
            "data",
            "person",
            "advisor",
            "rule"
          ],
          "type": "string"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "accepted",
            "overridden"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "key",
        "choice",
        "reason"
      ],
      "type": "object"
    },
    "JsonValue": {},
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "maxLength": 4000,
          "type": "string"
        },
        "cites": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "statement": {
          "maxLength": 4000,
          "type": "string"
        }
      },
      "required": [
        "statement",
        "check"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "maxItems": 60,
      "type": "array"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/Risk"
      },
      "maxItems": 30,
      "type": "array"
    },
    "schema_version": {
      "const": "dclab_core.solution_plan.v1",
      "default": "dclab_core.solution_plan.v1",
      "type": "string"
    },
    "task": {
      "default": "unknown",
      "enum": [
        "binary",
        "multiclass",
        "regression",
        "unknown"
      ],
      "type": "string"
    },
    "would_change": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "type": "object"
}
