{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "answerer": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "by": {
          "enum": [
            "rule",
            "model_role",
            "classifier",
            "person"
          ],
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "by",
        "answerer",
        "value"
      ],
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "column",
            "project",
            "draft",
            "conversation",
            "workflow",
            "proposal"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answers": {
      "items": {
        "$ref": "#/$defs/Answer"
      },
      "maxItems": 20,
      "type": "array"
    },
    "at": {
      "type": "string"
    },
    "consent": {
      "default": "operate",
      "enum": [
        "operate",
        "improve",
        "train"
      ],
      "type": "string"
    },
    "conversation": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dataset": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "draft": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_partition": {
      "anyOf": [
        {
          "enum": [
            "metadata",
            "train"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "experiment": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^[A-Za-z0-9_.:-]{6,80}$",
      "type": "string"
    },
    "level": {
      "default": 0,
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "options": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "point": {
      "type": "string"
    },
    "project": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review": {
      "default": false,
      "type": "boolean"
    },
    "run": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "dclab_core.decision_record.v2",
      "default": "dclab_core.decision_record.v2",
      "type": "string"
    },
    "state": {
      "additionalProperties": true,
      "type": "object"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "used": {
      "default": "none",
      "enum": [
        "rule",
        "model_role",
        "classifier",
        "person",
        "none"
      ],
      "type": "string"
    },
    "value_used": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workspace": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "id",
    "point",
    "subject",
    "at"
  ],
  "type": "object"
}
