{
  "additionalProperties": false,
  "properties": {
    "bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "captured_at": {
      "type": "string"
    },
    "consent": {
      "default": "operate",
      "enum": [
        "operate",
        "improve",
        "train"
      ],
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "type": "string"
    },
    "kind": {
      "enum": [
        "sessions",
        "actions",
        "decisions",
        "conversations",
        "tasks",
        "workflows",
        "fixes",
        "tests",
        "model_requests",
        "agents",
        "teachers",
        "students",
        "audit",
        "deletions",
        "curation",
        "other"
      ],
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 600,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "offset": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "path": {
      "maxLength": 400,
      "type": "string"
    },
    "run": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "dclab_core.store_entry.v1",
      "default": "dclab_core.store_entry.v1",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "maxLength": 4000,
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "whole_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workspace": {
      "maxLength": 120,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "source",
    "workspace",
    "version",
    "sha256",
    "bytes",
    "captured_at",
    "path"
  ],
  "type": "object"
}
