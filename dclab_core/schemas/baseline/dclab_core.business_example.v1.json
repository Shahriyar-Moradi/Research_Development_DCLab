{
  "$defs": {
    "ExampleSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "research_track",
            "campaign",
            "replica",
            "owner_solution",
            "written"
          ],
          "type": "string"
        },
        "ref": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "maxLength": 80,
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 600,
          "type": "string"
        },
        "source": {
          "maxLength": 600,
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "source"
      ],
      "type": "object"
    },
    "Understanding": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "family": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "labels": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "moment": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "items": {
        "type": "string"
      },
      "maxItems": 40,
      "type": "array"
    },
    "id": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "industry": {
      "default": "",
      "maxLength": 80,
      "type": "string"
    },
    "pitfalls": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "problem": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/Result"
      },
      "maxItems": 12,
      "type": "array"
    },
    "schema_version": {
      "const": "dclab_core.business_example.v1",
      "default": "dclab_core.business_example.v1",
      "type": "string"
    },
    "solution": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/ExampleSource"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "understanding": {
      "$ref": "#/$defs/Understanding"
    },
    "workflow": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "problem",
    "source"
  ],
  "type": "object"
}
