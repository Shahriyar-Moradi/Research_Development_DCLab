{
  "additionalProperties": false,
  "properties": {
    "at": {
      "type": "string"
    },
    "by": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "consent": {
      "default": "operate",
      "enum": [
        "operate",
        "improve",
        "train"
      ],
      "type": "string"
    },
    "higher_is_better": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^[A-Za-z0-9_.:-]{6,80}$",
      "type": "string"
    },
    "interval": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metric": {
      "pattern": "^[A-Za-z0-9_.:%/-]{1,80}$",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observed": {
      "enum": [
        "holdout",
        "promotion",
        "business"
      ],
      "type": "string"
    },
    "point": {
      "type": "string"
    },
    "project": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "record": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "reference": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "dclab_core.outcome.v1",
      "default": "dclab_core.outcome.v1",
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "verdict": {
      "enum": [
        "well",
        "badly",
        "unknown"
      ],
      "type": "string"
    },
    "workspace": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "id",
    "record",
    "point",
    "metric",
    "value",
    "observed",
    "verdict",
    "by",
    "at"
  ],
  "type": "object"
}
