{
  "$defs": {
    "Requester": {
      "additionalProperties": false,
      "properties": {
        "member": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "team": {
          "pattern": "^[a-z][a-z0-9_]*(:[A-Za-z0-9_.-]+)?$",
          "type": "string"
        },
        "thread_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
          "type": "string"
        }
      },
      "required": [
        "team",
        "thread_id"
      ],
      "type": "object"
    },
    "TargetContract": {
      "additionalProperties": false,
      "properties": {
        "brief_revision": {
          "minimum": 1,
          "type": "integer"
        },
        "confirmed_by": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event": {
          "pattern": "^[a-z][a-z0-9_]{0,59}$",
          "type": "string"
        },
        "horizon": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label_source": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,119}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "maturity_rule": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prediction_time": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,119}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "dclab_core.target_contract.v1",
          "default": "dclab_core.target_contract.v1",
          "type": "string"
        },
        "words": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event",
        "words",
        "brief_revision",
        "confirmed_by"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_inputs": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "type": "array"
    },
    "allowed_tools": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "type": "array"
    },
    "brief_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "budget_eur": {
      "default": 0.0,
      "minimum": 0,
      "type": "number"
    },
    "created_at": {
      "type": "string"
    },
    "done_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "expected_output": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
      "type": "string"
    },
    "owner_team": {
      "pattern": "^[a-z][a-z0-9_]*(:[A-Za-z0-9_.-]+)?$",
      "type": "string"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "problem_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
      "type": "string"
    },
    "question": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "requester": {
      "$ref": "#/$defs/Requester"
    },
    "schema_version": {
      "const": "dclab_core.team_task.v2",
      "default": "dclab_core.team_task.v2",
      "type": "string"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "accepted",
        "waiting_for_person",
        "waiting_for_team",
        "partial",
        "complete",
        "blocked",
        "failed",
        "cancelled",
        "superseded"
      ],
      "type": "string"
    },
    "superseded_by": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workspace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,119}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "workspace_id",
    "project_id",
    "problem_id",
    "brief_revision",
    "requester",
    "owner_team",
    "question",
    "expected_output",
    "done_criteria",
    "created_at"
  ],
  "type": "object"
}
