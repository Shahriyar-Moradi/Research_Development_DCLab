{
  "additionalProperties": false,
  "properties": {
    "agent": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "delivery": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "euros": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fallback": {
      "anyOf": [
        {
          "enum": [
            "no_model",
            "no_live_models",
            "refused",
            "timeout",
            "invalid_output",
            "error",
            "stopped",
            "busy",
            "unsure",
            "check_failed",
            "budget",
            "person_entry",
            "no_action"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "enum": [
        "acted",
        "fell_back",
        "ended",
        "repeat"
      ],
      "type": "string"
    },
    "plan_chars": {
      "default": 0,
      "maximum": 4000,
      "minimum": 0,
      "type": "integer"
    },
    "plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_steps": {
      "default": 0,
      "maximum": 200,
      "minimum": 0,
      "type": "integer"
    },
    "refusals": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "type": "array"
    },
    "refused": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "request": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "role": {
      "enum": [
        "lead",
        "business",
        "data_science",
        "ml_engineering",
        "sales",
        "marketing"
      ],
      "type": "string"
    },
    "run": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "dclab_core.team_agent_turn.v1",
      "default": "dclab_core.team_agent_turn.v1",
      "type": "string"
    },
    "seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sentences_kept": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "sentences_refused": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "steps": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "stopped": {
      "anyOf": [
        {
          "enum": [
            "answered",
            "steps",
            "time",
            "euros",
            "replies",
            "max_output_tokens",
            "tools_as_text",
            "error",
            "timeout",
            "refused",
            "interrupted",
            "no_plan"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "type": "array"
    },
    "writes": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "role",
    "agent",
    "outcome"
  ],
  "type": "object"
}
