{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consent": {
          "default": "operate",
          "enum": [
            "operate",
            "improve",
            "train"
          ],
          "type": "string"
        },
        "deleted": {
          "default": false,
          "type": "boolean"
        },
        "draft": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entry": {
          "maxLength": 200,
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source": {
          "maxLength": 4000,
          "type": "string"
        },
        "workspace": {
          "maxLength": 120,
          "type": "string"
        }
      },
      "required": [
        "entry",
        "sha256",
        "source",
        "workspace",
        "at"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cited": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "corpus": {
      "maxLength": 80,
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "type": "string"
    },
    "model_type": {
      "enum": [
        "m1_students",
        "m2_workflow_decisions",
        "m3_ml_decisions",
        "m4_workflow_llm",
        "m5_solver_llm",
        "m6_stepwise_decisions",
        "m7_judges",
        "m8_retrieval"
      ],
      "type": "string"
    },
    "more": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "type": "array"
    },
    "offered": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "query": {
      "maxLength": 2000,
      "type": "string"
    },
    "schema_version": {
      "const": "dclab_core.retrieval_example.v1",
      "default": "dclab_core.retrieval_example.v1",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "sealed"
      ],
      "type": "string"
    },
    "used": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "weight": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "id",
    "model_type",
    "split",
    "provenance",
    "corpus",
    "query"
  ],
  "type": "object"
}
