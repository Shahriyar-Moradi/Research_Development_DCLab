{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consent": {
          "default": "operate",
          "enum": [
            "operate",
            "improve",
            "train"
          ],
          "type": "string"
        },
        "deleted": {
          "default": false,
          "type": "boolean"
        },
        "draft": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entry": {
          "maxLength": 200,
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source": {
          "maxLength": 4000,
          "type": "string"
        },
        "workspace": {
          "maxLength": 120,
          "type": "string"
        }
      },
      "required": [
        "entry",
        "sha256",
        "source",
        "workspace",
        "at"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "at": {
      "type": "string"
    },
    "body": {
      "additionalProperties": true,
      "type": "object"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "maxLength": 200,
      "type": "string"
    },
    "kind": {
      "enum": [
        "sessions",
        "actions",
        "decisions",
        "conversations",
        "tasks",
        "workflows",
        "fixes",
        "tests",
        "model_requests",
        "agents",
        "teachers",
        "students",
        "audit",
        "deletions",
        "curation",
        "other"
      ],
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "dclab_core.store_record.v1",
      "default": "dclab_core.store_record.v1",
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "enum": [
            "train",
            "dev",
            "sealed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "type": {
      "maxLength": 80,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "type",
    "at",
    "provenance"
  ],
  "type": "object"
}
