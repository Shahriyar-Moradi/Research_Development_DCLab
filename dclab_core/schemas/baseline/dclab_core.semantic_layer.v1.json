{
  "$defs": {
    "Dimension": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        },
        "label": {
          "maxLength": 120,
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        }
      },
      "required": [
        "name",
        "label",
        "columns"
      ],
      "type": "object"
    },
    "Factorization": {
      "additionalProperties": false,
      "properties": {
        "factors": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 2,
          "type": "array"
        },
        "metric": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "factors"
      ],
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "default": "",
          "maxLength": 120,
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "sum",
            "ratio"
          ],
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "default": "",
          "maxLength": 40,
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "kind"
      ],
      "type": "object"
    },
    "NotHeld": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 60,
          "type": "string"
        },
        "needs": {
          "maxLength": 300,
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        }
      },
      "required": [
        "name",
        "needs"
      ],
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "date"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dimensions": {
      "items": {
        "$ref": "#/$defs/Dimension"
      },
      "maxItems": 20,
      "type": "array"
    },
    "factorizations": {
      "items": {
        "$ref": "#/$defs/Factorization"
      },
      "maxItems": 20,
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
    },
    "not_held": {
      "items": {
        "$ref": "#/$defs/NotHeld"
      },
      "maxItems": 30,
      "type": "array"
    },
    "schema_version": {
      "const": "dclab_core.semantic_layer.v1",
      "default": "dclab_core.semantic_layer.v1",
      "type": "string"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/Table"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "tables",
    "metrics"
  ],
  "type": "object"
}
