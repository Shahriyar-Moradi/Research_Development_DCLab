{
  "$defs": {
    "JsonValue": {},
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "consent": {
          "enum": [
            "owner",
            "train",
            "improve",
            "public",
            "ours"
          ],
          "type": "string"
        },
        "from_sealed": {
          "default": false,
          "type": "boolean"
        },
        "group": {
          "maxLength": 200,
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "enum": [
            "construction",
            "replica",
            "factory_rule",
            "rule_prod",
            "human_exposed",
            "human_blind",
            "measured_outcome",
            "public_catalog",
            "verified_synthetic",
            "research_record",
            "dev_record",
            "teacher_claude"
          ],
          "type": "string"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "source": {
          "maxLength": 200,
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "dev",
            "sealed",
            "eval_only"
          ],
          "type": "string"
        }
      },
      "required": [
        "source",
        "origin",
        "consent",
        "group",
        "split"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_point": {
      "maxLength": 80,
      "type": "string"
    },
    "evidence_partition": {
      "default": "metadata",
      "enum": [
        "metadata",
        "train"
      ],
      "type": "string"
    },
    "feature_schema_version": {
      "default": "v1",
      "maxLength": 40,
      "type": "string"
    },
    "features": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "label": {
      "$ref": "#/$defs/JsonValue"
    },
    "label_confidence": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "options": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "other_answers": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "question": {
      "anyOf": [
        {
          "maxLength": 400,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rule_answer": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "sample_id": {
      "maxLength": 80,
      "type": "string"
    },
    "schema_version": {
      "const": "dclab_core.decision_sample.v1",
      "default": "dclab_core.decision_sample.v1",
      "type": "string"
    },
    "state_text": {
      "maxLength": 16000,
      "type": "string"
    },
    "subject_kind": {
      "enum": [
        "column",
        "dataset",
        "problem",
        "step"
      ],
      "type": "string"
    },
    "subject_ref": {
      "maxLength": 200,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "decision_point",
    "subject_kind",
    "subject_ref",
    "state_text",
    "label",
    "provenance"
  ],
  "type": "object"
}
