{
  "$defs": {
    "VersionEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "maxLength": 120,
          "title": "By",
          "type": "string"
        },
        "forgotten": {
          "description": "the exam sections it fell on, from the exam's decision",
          "items": {
            "type": "string"
          },
          "title": "Forgotten",
          "type": "array"
        },
        "reason": {
          "default": "",
          "maxLength": 600,
          "title": "Reason",
          "type": "string"
        },
        "roles": {
          "description": "the roles switched back by a retirement",
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "status": {
          "enum": [
            "trained",
            "accepted",
            "refused",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "at",
        "status",
        "by"
      ],
      "title": "VersionEvent",
      "type": "object"
    }
  },
  "$id": "https://dclab.dev/schemas/dclab_core.trained_version.v1.json",
  "additionalProperties": false,
  "properties": {
    "base_model": {
      "maxLength": 120,
      "title": "Base Model",
      "type": "string"
    },
    "exam_hash": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exam Hash"
    },
    "exam_version": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exam Version"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/VersionEvent"
      },
      "minItems": 1,
      "title": "History",
      "type": "array"
    },
    "model_type": {
      "maxLength": 40,
      "title": "Model Type",
      "type": "string"
    },
    "replay_share": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Replay Share",
      "type": "number"
    },
    "round": {
      "description": "the replay round (36.5) it was trained on",
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "round_train_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Round Train Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "dclab_core.trained_version.v1",
      "default": "dclab_core.trained_version.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "served_as": {
      "description": "the name the tuned tier serves it under (DCLAB_TIER_TUNED_MODEL)",
      "maxLength": 120,
      "minLength": 1,
      "title": "Served As",
      "type": "string"
    },
    "sets": {
      "description": "the sets the round read: folder, version, manifest hash",
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Sets",
      "type": "array"
    },
    "version": {
      "description": "the version's own name (the exam's model_version)",
      "maxLength": 120,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "model_type",
    "version",
    "served_as",
    "base_model",
    "round",
    "round_train_sha256",
    "replay_share",
    "history"
  ],
  "title": "TrainedVersion",
  "type": "object"
}
