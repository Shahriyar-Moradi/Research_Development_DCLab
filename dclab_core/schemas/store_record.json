{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a record or an example came from (carried by every one).",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "consent": {
          "default": "operate",
          "enum": [
            "operate",
            "improve",
            "train"
          ],
          "title": "Consent",
          "type": "string"
        },
        "deleted": {
          "default": false,
          "title": "Deleted",
          "type": "boolean"
        },
        "draft": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft"
        },
        "entry": {
          "maxLength": 200,
          "title": "Entry",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "maxLength": 4000,
          "title": "Source",
          "type": "string"
        },
        "workspace": {
          "maxLength": 120,
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "entry",
        "sha256",
        "source",
        "workspace",
        "at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://dclab.dev/schemas/dclab_core.store_record.v1.json",
  "additionalProperties": false,
  "description": "One normalised record of a kind (v1): its body is the kind's own shape, scrubbed (no secret, no table row).",
  "properties": {
    "at": {
      "title": "At",
      "type": "string"
    },
    "body": {
      "additionalProperties": true,
      "title": "Body",
      "type": "object"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "id": {
      "maxLength": 200,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "sessions",
        "actions",
        "decisions",
        "conversations",
        "tasks",
        "workflows",
        "fixes",
        "tests",
        "model_requests",
        "agents",
        "teachers",
        "students",
        "audit",
        "deletions",
        "curation",
        "other"
      ],
      "title": "Kind",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "dclab_core.store_record.v1",
      "default": "dclab_core.store_record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "enum": [
            "train",
            "dev",
            "sealed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split"
    },
    "type": {
      "maxLength": 80,
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "type",
    "at",
    "provenance"
  ],
  "title": "StoreRecord",
  "type": "object"
}
