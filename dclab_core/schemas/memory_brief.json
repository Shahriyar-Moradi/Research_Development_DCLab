{
  "$id": "https://dclab.dev/schemas/dclab_core.memory_brief.v1.json",
  "additionalProperties": false,
  "description": "What an agent reads at the start of a session (v1): the items' ids in order, their lines, the tokens used.",
  "properties": {
    "budget": {
      "default": 800,
      "minimum": 0,
      "title": "Budget",
      "type": "integer"
    },
    "items": {
      "items": {
        "type": "string"
      },
      "title": "Items",
      "type": "array"
    },
    "left_out": {
      "default": 0,
      "minimum": 0,
      "title": "Left Out",
      "type": "integer"
    },
    "schema_version": {
      "const": "dclab_core.memory_brief.v1",
      "default": "dclab_core.memory_brief.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "text": {
      "default": "",
      "title": "Text",
      "type": "string"
    },
    "tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Tokens",
      "type": "integer"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "Brief",
  "type": "object"
}
