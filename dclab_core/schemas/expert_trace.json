    },
    "problem_type": {
      "$ref": "#/$defs/ProblemType"
    },
    "problem_workflow": {
      "$ref": "#/$defs/ProblemWorkflow"
    },
    "problems": {
      "description": "What was missing or misshapen in the answer it was read from.",
      "items": {
        "maxLength": 400,
        "type": "string"
      },
      "maxItems": 60,
      "title": "Problems",
      "type": "array"
