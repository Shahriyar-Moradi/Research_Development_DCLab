      "type": "array"
    },
    "checkpoint": {
      "default": "initial",
      "maxLength": 40,
      "title": "Checkpoint",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "data": {
