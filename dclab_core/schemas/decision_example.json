{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "maxLength": 120,
          "title": "By",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "by"
      ],
      "title": "Answer",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a record or an example came from (carried by every one).",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "consent": {
          "default": "operate",
          "enum": [
            "operate",
            "improve",
            "train"
          ],
          "title": "Consent",
          "type": "string"
        },
        "deleted": {
          "default": false,
          "title": "Deleted",
          "type": "boolean"
        },
        "draft": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft"
        },
        "entry": {
          "maxLength": 200,
          "title": "Entry",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "maxLength": 4000,
          "title": "Source",
          "type": "string"
        },
        "workspace": {
          "maxLength": 120,
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "entry",
        "sha256",
        "source",
        "workspace",
        "at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://dclab.dev/schemas/dclab_core.decision_example.v2.json",
  "additionalProperties": false,
  "description": "M1, M2, M3: one decision as a classifier learns it (v2: ``split_group``, the table or project it belongs to, so folds and\nsplits keep one table's rows together; v1 reads, its split group unknown).",
  "properties": {
    "answers": {
      "items": {
        "$ref": "#/$defs/Answer"
      },
      "title": "Answers",
      "type": "array"
    },
    "group": {
      "maxLength": 80,
      "title": "Group",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "title": "Id",
      "type": "string"
    },
    "label": {
      "default": null,
      "title": "Label"
    },
    "label_source": {
      "anyOf": [
        {
          "enum": [
            "person",
            "measured",
            "benchmark",
            "blind",
            "teacher",
            "rule"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label Source"
    },
    "model_type": {
      "enum": [
        "m1_students",
        "m2_workflow_decisions",
        "m3_ml_decisions",
        "m4_workflow_llm",
        "m5_solver_llm",
        "m6_stepwise_decisions",
        "m7_judges",
        "m8_retrieval"
      ],
      "title": "Model Type",
      "type": "string"
    },
    "more": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "More",
      "type": "array"
    },
    "options": {
      "items": {
        "type": "string"
      },
      "title": "Options",
      "type": "array"
    },
    "point": {
      "maxLength": 120,
      "title": "Point",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "dclab_core.decision_example.v2",
      "default": "dclab_core.decision_example.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "sealed"
      ],
      "title": "Split",
      "type": "string"
    },
    "split_group": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split Group"
    },
    "state": {
      "additionalProperties": true,
      "title": "State",
      "type": "object"
    },
    "weight": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Weight",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "id",
    "model_type",
    "split",
    "provenance",
    "point",
    "group"
  ],
  "title": "DecisionExample",
  "type": "object"
}
