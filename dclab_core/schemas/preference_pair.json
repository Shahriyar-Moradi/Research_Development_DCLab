{
  "$defs": {
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "no_reasoning": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Reasoning"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "reasoning_source": {
          "anyOf": [
            {
              "enum": [
                "recorded",
                "from_record",
                "teacher"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Source"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a record or an example came from (carried by every one).",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "consent": {
          "default": "operate",
          "enum": [
            "operate",
            "improve",
            "train"
          ],
          "title": "Consent",
          "type": "string"
        },
        "deleted": {
          "default": false,
          "title": "Deleted",
          "type": "boolean"
        },
        "draft": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft"
        },
        "entry": {
          "maxLength": 200,
          "title": "Entry",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "maxLength": 4000,
          "title": "Source",
          "type": "string"
        },
        "workspace": {
          "maxLength": 120,
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "entry",
        "sha256",
        "source",
        "workspace",
        "at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://dclab.dev/schemas/dclab_core.preference_pair.v1.json",
  "additionalProperties": false,
  "description": "M4, M5, M7: one prompt, the chosen and the rejected answers, and who decided (v1).",
  "properties": {
    "chosen": {
      "$ref": "#/$defs/Message"
    },
    "decided_by": {
      "enum": [
        "person",
        "measured",
        "benchmark",
        "blind",
        "teacher",
        "rule"
      ],
      "title": "Decided By",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "title": "Id",
      "type": "string"
    },
    "model_type": {
      "enum": [
        "m1_students",
        "m2_workflow_decisions",
        "m3_ml_decisions",
        "m4_workflow_llm",
        "m5_solver_llm",
        "m6_stepwise_decisions",
        "m7_judges",
        "m8_retrieval"
      ],
      "title": "Model Type",
      "type": "string"
    },
    "more": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "More",
      "type": "array"
    },
    "prompt": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "minItems": 1,
      "title": "Prompt",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rejected": {
      "$ref": "#/$defs/Message"
    },
    "schema_version": {
      "const": "dclab_core.preference_pair.v1",
      "default": "dclab_core.preference_pair.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "sealed"
      ],
      "title": "Split",
      "type": "string"
    },
    "task": {
      "maxLength": 120,
      "title": "Task",
      "type": "string"
    },
    "weight": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Weight",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "id",
    "model_type",
    "split",
    "provenance",
    "task",
    "prompt",
    "chosen",
    "rejected",
    "decided_by"
  ],
  "title": "PreferencePair",
  "type": "object"
}
