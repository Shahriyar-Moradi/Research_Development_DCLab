{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a record or an example came from (carried by every one).",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "consent": {
          "default": "operate",
          "enum": [
            "operate",
            "improve",
            "train"
          ],
          "title": "Consent",
          "type": "string"
        },
        "deleted": {
          "default": false,
          "title": "Deleted",
          "type": "boolean"
        },
        "draft": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft"
        },
        "entry": {
          "maxLength": 200,
          "title": "Entry",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "maxLength": 4000,
          "title": "Source",
          "type": "string"
        },
        "workspace": {
          "maxLength": 120,
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "entry",
        "sha256",
        "source",
        "workspace",
        "at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://dclab.dev/schemas/dclab_core.retrieval_example.v1.json",
  "additionalProperties": false,
  "description": "M8: a query, the passages offered, the ones used and cited, and whether the answer passed (v1).",
  "properties": {
    "cited": {
      "items": {
        "type": "string"
      },
      "title": "Cited",
      "type": "array"
    },
    "corpus": {
      "maxLength": 80,
      "title": "Corpus",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "title": "Id",
      "type": "string"
    },
    "model_type": {
      "enum": [
        "m1_students",
        "m2_workflow_decisions",
        "m3_ml_decisions",
        "m4_workflow_llm",
        "m5_solver_llm",
        "m6_stepwise_decisions",
        "m7_judges",
        "m8_retrieval"
      ],
      "title": "Model Type",
      "type": "string"
    },
    "more": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "More",
      "type": "array"
    },
    "offered": {
      "items": {
        "type": "string"
      },
      "title": "Offered",
      "type": "array"
    },
    "passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Passed"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "query": {
      "maxLength": 2000,
      "title": "Query",
      "type": "string"
    },
    "schema_version": {
      "const": "dclab_core.retrieval_example.v1",
      "default": "dclab_core.retrieval_example.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "sealed"
      ],
      "title": "Split",
      "type": "string"
    },
    "used": {
      "items": {
        "type": "string"
      },
      "title": "Used",
      "type": "array"
    },
    "weight": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Weight",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "id",
    "model_type",
    "split",
    "provenance",
    "corpus",
    "query"
  ],
  "title": "RetrievalExample",
  "type": "object"
}
