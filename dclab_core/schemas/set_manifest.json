{
  "$id": "https://dclab.dev/schemas/dclab_core.set_manifest.v2.json",
  "additionalProperties": false,
  "description": "One training set (v2): its model type, shape, sources with their hashes, split rule, counts, labels, consent and checks\n(v2, 2026-10-29: the model type is any of :data:`MODEL_TYPES`, ``m7_routing`` included; v1 reads).",
  "properties": {
    "built_at": {
      "title": "Built At",
      "type": "string"
    },
    "commit": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit"
    },
    "consent": {
      "default": "train",
      "enum": [
        "operate",
        "improve",
        "train"
      ],
      "title": "Consent",
      "type": "string"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "decontaminated": {
      "items": {
        "type": "string"
      },
      "title": "Decontaminated",
      "type": "array"
    },
    "label_sources": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Label Sources",
      "type": "object"
    },
    "model_type": {
      "maxLength": 40,
      "title": "Model Type",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "title": "Name",
      "type": "string"
    },
    "quarantined": {
      "default": 0,
      "title": "Quarantined",
      "type": "integer"
    },
    "schema_version": {
      "const": "dclab_core.set_manifest.v2",
      "default": "dclab_core.set_manifest.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "shape": {
      "maxLength": 80,
      "title": "Shape",
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Sources",
      "type": "array"
    },
    "split_rule": {
      "maxLength": 200,
      "title": "Split Rule",
      "type": "string"
    },
    "version": {
      "maxLength": 40,
      "title": "Version",
      "type": "string"
    },
    "weights": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Weights",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "model_type",
    "name",
    "version",
    "shape",
    "split_rule",
    "built_at"
  ],
  "title": "SetManifest",
  "type": "object"
}
