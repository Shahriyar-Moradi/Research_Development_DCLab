  "commit": "7fa23b977685634c9e103771a9a502c96830afde",
  "commit_date": "2026-10-09T04:58:26Z",
  "read_on": "2026-10-12",
  "read_with": "gh api repos/Shahriyar-Moradi/DCLab/contents/<path>?ref=<commit> (read only)",
  "contracts": {
    "ProblemSpec": {
      "path": "apps/api/app/services/problem_spec_service.py",
      "symbol": "_content_payload (the content digest); limits from ProblemSpecCreateRequest in apps/api/app/domain/workspace_identity.py",
      "version": null,
      "fields": {
        "task_type": "str",
        "business_objective": "str",
        "target_column": "str | None",
        "prediction_unit": "str | None",
        "prediction_time_column": "str | None",
        "prediction_horizon": "str | None",
        "primary_metric": "str | None",
        "constraints": "dict[str, Any]",
        "success_criteria": "dict[str, Any]"
      },
      "max_length": {
        "task_type": 64,
        "business_objective": 4000,
        "target_column": 256,
        "prediction_unit": 128,
        "prediction_time_column": 256,
        "prediction_horizon": 128,
        "primary_metric": 128
      },
      "json_max_bytes": 16384,
      "json_max_bytes_applies_to": [
        "constraints",
        "success_criteria"
      ],
      "constraints_structured_keys": {
        "primary_metric_reason": "str",
        "metric_constraints": "list[{metric: str, op: '>=' | '<=', value: float}]",
        "cost_matrix": "{false_positive: float >= 0, false_negative: float >= 0} (binary and classification only)"
      },
      "not_content": {
        "status": "str: draft | locked (a person locks it)",
        "plan": "UUID | None: an ExperimentPlanProposal whose target_column and primary_metric fill the spec"
      },
      "task_types": [
        "binary",
        "multiclass",
        "regression",
        "classification"
      ]
    },
    "ProblemProfile": {
      "path": "apps/api/app/engine/modeling/problem_profile.py",
      "symbol": "ProblemProfile (dataclass); built by build_problem_profile(train, target=, task_type=) on the locked training partition",
