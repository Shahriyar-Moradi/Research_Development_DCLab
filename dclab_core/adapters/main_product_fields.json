      "path": "apps/api/app/domain/run_plans.py",
      "symbol": "ExperimentPlan (frozen pydantic, extra=forbid): the payload of an ExperimentPlanProposal, one field group per decision point (PLAN_FIELDS)",
      "version": null,
      "fields": {
        "target_column": "str | None",
        "primary_metric": "str | None (pattern ^[a-z][a-z0-9_]{0,63}$)",
