        "group_column": "str | None",
        "time_column": "str | None",
        "stratified": "bool",
        "reason": "str",
        "fallback_reason": "str | None",
        "evidence": "dict[str, Any]",
        "version": "str"
      },
      "defaults": {"requested_folds": 5, "random_state": 42}
