  "decision_points": {
    "path": "apps/api/app/agents/governance/decision_points.py",
    "symbol": "REGISTRY (every point starts at L0; cap is the highest level code allows)",
    "points": {
      "target.column": {"stage": "run_target_resolution", "pattern": "ai_before", "ai_kind": "agent:dataset_investigator", "rule_id": "lab_decision_ledger.record_target_selection", "effects": ["proposal:problem_spec"], "evidence_partition": "metadata", "cap": 1},
      "spec.objective": {"stage": "propose_problem_spec", "pattern": "ai_before", "ai_kind": "agent:experiment_planner", "rule_id": "metric_planner.default_metric", "effects": ["proposal:problem_spec"], "evidence_partition": "metadata", "cap": 1},
      "column.is_identifier": {"stage": "run_column_roles", "pattern": "cross_check", "ai_kind": "jev:column.is_identifier", "rule_id": "schema_inference.identifier.v1", "effects": ["exclusion"], "evidence_partition": "metadata", "cap": 1},
      "column.semantic_role": {"stage": "run_column_roles", "pattern": "cross_check", "ai_kind": "jev:column.semantic_role", "rule_id": "split_column_roles.v3", "effects": ["branch_change:feature_transform_add"], "evidence_partition": "metadata", "cap": 2},
      "column.missing_value_action": {"stage": "run_train_only_decisions", "pattern": "ai_before", "ai_kind": "agent:dataset_investigator", "rule_id": "missing_value_rules.v1", "effects": ["branch_change:feature_transform_add"], "evidence_partition": "train", "cap": 2},
      "feature.leakage_suspect": {"stage": "run_train_only_decisions", "pattern": "cross_check", "ai_kind": "jev:feature.leakage_suspect", "rule_id": "leakage_auditor.v1", "effects": ["flag"], "evidence_partition": "train", "cap": 1},
      "split.strategy": {"stage": "run_holdout_lock", "pattern": "ai_before", "ai_kind": "agent:experiment_planner", "rule_id": "holdout_planner.v1", "effects": ["split_plan"], "evidence_partition": "metadata", "cap": 1},
      "training.families_budget": {"stage": "run_preprocessing_setup", "pattern": "ai_before", "ai_kind": "agent:experiment_planner", "rule_id": "portfolio.v1", "effects": ["search_config"], "evidence_partition": "train", "cap": 2},
      "experiment.review": {"stage": "agents.run", "pattern": "ai_after", "ai_kind": "agent:experiment_critic", "rule_id": "pipeline_verifier.v1", "effects": ["none"], "evidence_partition": "train", "cap": 1},
      "improve.next_action": {"stage": "labs.improve", "pattern": "cross_check", "ai_kind": "agent:improvement_hypothesis", "rule_id": "rule_proposer.v1", "effects": ["proposal:experiment_change"], "evidence_partition": "train", "cap": 1},
      "ops.diagnose": {"stage": "monitoring.drift_window", "pattern": "ai_after", "ai_kind": "agent:dataset_investigator", "rule_id": "drift_finding.v1", "effects": ["notify"], "evidence_partition": "train", "cap": 3},
      "ops.retrain": {"stage": "ops.agent", "pattern": "ai_before", "ai_kind": "agent:ops", "rule_id": null, "effects": ["job:experiments.run"], "evidence_partition": "metadata", "cap": 2},
      "ops.release": {"stage": "ops.agent", "pattern": "ai_before", "ai_kind": "agent:ops", "rule_id": "release_gate.v1", "effects": ["proposal:model_release"], "evidence_partition": "train", "cap": 1},
      "ops.rollback": {"stage": "ops.agent", "pattern": "ai_before", "ai_kind": "agent:ops", "rule_id": "ops.rollback_threshold.v1", "effects": ["proposal:ref_move"], "evidence_partition": "train", "cap": 1},
      "command.intent_route": {"stage": "assistant.turn", "pattern": "ai_before", "ai_kind": "jev:command.intent_route", "rule_id": null, "effects": ["none"], "evidence_partition": "metadata", "cap": 1},
      "proposal.completeness": {"stage": "proposal.validated", "pattern": "ai_after", "ai_kind": "jev:proposal.completeness", "rule_id": "validator_verdict", "effects": ["none"], "evidence_partition": "metadata", "cap": 0}
    },
    "lead_tools": ["create_problem_spec", "propose_problem_spec", "record_decision", "request_agent_review", "move_ref", "run_experiment", "branch_experiment", "predict"]
