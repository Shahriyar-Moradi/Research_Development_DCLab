      "fields": {
        "strategy": "str",
        "test_size": "float",
        "random_state": "int",
        "stratified": "bool",
        "group_column": "str | None",
        "time_column": "str | None",
        "reason": "str",
        "evidence": "dict[str, Any]",
        "plan_version": "str"
      },
      "defaults": {"test_size": 0.2, "random_state": 42}
