    "Objective": {
      "path": "apps/api/app/engine/modeling/objective.py",
      "symbol": "Objective (dataclass); parse_objective(task_type, primary_metric=, constraints=) reads it from a ProblemSpec",
      "version": "dclab.objective.v1",
      "fields": {
        "primary_metric": "str | None",
        "primary_metric_reason": "str | None",
        "constraints": "list[MetricConstraint{metric: str, op: str, value: float}]",
        "cost_false_positive": "float | None",
        "cost_false_negative": "float | None",
        "version": "str"
      }
    },
    "DecisionThreshold": {
      "path": "apps/api/app/engine/modeling/objective.py",
      "symbol": "select_decision_threshold(y_oof, scores_oof, objective) -> dict (THRESHOLD_VERSION)",
      "version": "dclab.decision_threshold.v1",
      "fields": {
        "version": "str",
        "value": "float",
        "source": "str: default | cost_matrix | constraints | primary_metric",
        "selected_on": "str: out_of_fold_cv",
        "oof_row_count": "int",
        "goal_metric": "str | None",
        "threshold_status": "str: not_requested | satisfied | unsatisfiable",
        "status": "str",
        "reason": "str",
        "expected_cost": "float | None",
        "constraints": "list[dict]",
        "oof_at_threshold": "dict[str, float]"
      },
      "nested": {
        "oof_at_threshold": ["tp", "fp", "fn", "tn", "precision", "recall", "specificity", "f1", "accuracy", "balanced_accuracy"]
      }
    },
    "ExperimentPlan": {
      "path": "apps/api/app/domain/run_plans.py",
      "symbol": "ExperimentPlan (frozen pydantic, extra=forbid): the payload of an ExperimentPlanProposal, one field group per decision point (PLAN_FIELDS)",
      "version": null,
      "fields": {
        "target_column": "str | None",
        "primary_metric": "str | None (pattern ^[a-z][a-z0-9_]{0,63}$)",
        "split": "PlanSplit | None",
        "families": "tuple[str, ...] | None (1-16 registry family keys)",
        "max_training_seconds": "float | None (0 < x <= 600)",
        "missing_values": "dict[str, impute_median | impute_most_frequent | drop_column] | None"
      }
    },
    "PlanSplit": {
      "path": "apps/api/app/domain/run_plans.py",
      "symbol": "PlanSplit (frozen pydantic, extra=forbid)",
      "version": null,
      "fields": {
        "strategy": "Literal['stratified_random', 'random', 'group_disjoint', 'temporal_future']",
        "group_column": "str | None",
        "time_column": "str | None",
        "test_size": "float | None (0.05-0.5; the code-owned floor is 0.2)"
      }
    },
    "ExperimentReview": {
      "path": "apps/api/app/agents/classes/experiment_critic.py",
      "symbol": "ExperimentReview: the payload of an ExperimentReviewProposal at decision point experiment.review",
      "version": null,
      "fields": {
        "verdict": "Literal['promote_candidate', 'needs_work', 'reject']",
        "summary": "str (max 2000)",
        "cv_metrics": "list[CvMetricCitation{experiment_id: UUID, metric: str, value: float}] (max 20)",
        "findings": "list[FindingCitation{check: str, status: pass | warning | fail | not_evaluated, note: str}] (max 10)",
        "confidence": "float (0-1)"
      },
      "nested": {
        "findings[]": ["check", "status", "note"]
      }
    },
    "ExperimentChangeSet": {
      "path": "apps/api/app/domain/experiment_changes.py",
      "symbol": "ExperimentChangeSet: what a branched experiment changes (proposal:experiment_change at improve.next_action)",
      "version": null,
      "fields": {
        "schema_version": "Literal[1]",
        "changes": "list[ExperimentChange] (1-32; discriminated by kind)"
      }
    }
  },
  "vocabularies": {
    "primary_metrics_classification": "binary and multiclass together: a ProblemSpec may say 'classification' before the target is inspected",
    "primary_metrics": {
      "binary": ["pr_auc", "roc_auc", "f1", "balanced_accuracy", "accuracy", "log_loss", "brier_score"],
      "multiclass": ["macro_f1", "weighted_f1", "balanced_accuracy", "accuracy", "log_loss", "roc_auc_ovr"],
      "regression": ["mae", "rmse", "mse", "r2", "median_absolute_error"]
    },
    "secondary_metrics": {
      "binary": ["pr_auc", "roc_auc", "f1", "precision", "recall", "balanced_accuracy", "accuracy", "log_loss", "brier_score"],
      "multiclass": ["balanced_accuracy", "accuracy", "weighted_f1", "macro_precision", "macro_recall", "log_loss", "roc_auc_ovr"],
      "regression": ["rmse", "r2", "mse"]
    },
    "metric_aliases": {
      "auc": "roc_auc", "roc-auc": "roc_auc", "average_precision": "pr_auc", "pr-auc": "pr_auc", "f1_macro": "macro_f1",
      "macro-f1": "macro_f1", "f1_weighted": "weighted_f1", "logloss": "log_loss", "brier": "brier_score"
    },
    "holdout_strategies": ["stratified_random", "random", "group_disjoint", "temporal_future", "unsupported"],
    "validation_strategies": ["StratifiedKFold", "KFold", "StratifiedGroupKFold", "GroupKFold", "TimeSeriesSplit", "unsupported"],
    "plan_split_strategies": ["stratified_random", "random", "group_disjoint", "temporal_future"],
    "portfolio_families": {
      "classification": ["logistic_regression", "random_forest", "xgboost", "lightgbm", "catboost"],
      "regression": ["linear_regression", "random_forest_regressor", "xgboost_regressor", "lightgbm_regressor", "catboost_regressor"]
    },
    "portfolio_source": "apps/api/app/engine/search/generator.py open_ingest_families (each family only when installed)",
    "dummy_families": ["majority", "mean", "median"],
    "change_kinds": ["hyperparameter_override", "family_include", "family_exclude", "class_weighting", "threshold_objective", "metric_override", "feature_transform_add", "feature_transform_remove"],
    "missing_value_transforms": ["impute_median", "impute_most_frequent", "drop_column"],
    "finding_statuses": ["pass", "warning", "fail", "not_evaluated"],
    "code_pattern": "^[a-z][a-z0-9_]{0,63}$"
  },
  "plan_fields": {
    "path": "apps/api/app/domain/run_plans.py",
    "symbol": "PLAN_FIELDS",
    "fields": {
      "target.column": ["target_column"],
      "spec.objective": ["primary_metric"],
