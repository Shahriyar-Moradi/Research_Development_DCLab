  "read_with": "gh api repos/Shahriyar-Moradi/DCLab/contents/<path>?ref=<commit> (read only)",
  "contracts": {
    "ProblemSpec": {
      "path": "apps/api/app/services/problem_spec_service.py",
      "symbol": "_content_payload (the content digest); limits from ProblemSpecCreateRequest in apps/api/app/domain/workspace_identity.py",
      "version": null,
      "fields": {
        "task_type": "str",
        "business_objective": "str",
        "target_column": "str | None",
        "prediction_unit": "str | None",
        "prediction_time_column": "str | None",
        "prediction_horizon": "str | None",
        "primary_metric": "str | None",
        "constraints": "dict[str, Any]",
        "success_criteria": "dict[str, Any]"
      },
      "max_length": {
        "task_type": 64,
        "business_objective": 4000,
        "target_column": 256,
        "prediction_unit": 128,
        "prediction_time_column": 256,
        "prediction_horizon": 128,
        "primary_metric": 128
      },
      "json_max_bytes": 16384,
      "json_max_bytes_applies_to": ["constraints", "success_criteria"],
      "constraints_structured_keys": {
        "primary_metric_reason": "str",
        "metric_constraints": "list[{metric: str, op: '>=' | '<=', value: float}]",
        "cost_matrix": "{false_positive: float >= 0, false_negative: float >= 0} (binary and classification only)"
      },
      "not_content": {
        "status": "str: draft | locked (a person locks it)",
        "plan": "UUID | None: an ExperimentPlanProposal whose target_column and primary_metric fill the spec"
      },
      "task_types": ["binary", "multiclass", "regression", "classification"]
    },
    "ProblemProfile": {
      "path": "apps/api/app/engine/modeling/problem_profile.py",
      "symbol": "ProblemProfile (dataclass); built by build_problem_profile(train, target=, task_type=) on the locked training partition",
      "version": "dclab.problem_profile.v1",
      "fields": {
        "task_type": "str",
        "target": "str",
        "row_count": "int",
        "feature_count": "int",
        "class_distribution": "dict[str, int] | None",
        "minority_class_fraction": "float | None",
        "imbalance_ratio": "float | None",
        "regression_target": "dict[str, Any] | None",
        "numeric_columns": "list[str]",
        "categorical_columns": "list[str]",
        "boolean_columns": "list[str]",
        "datetime_columns": "list[str]",
        "identifier_columns": "list[str]",
        "free_text_columns": "list[str]",
        "high_cardinality_columns": "list[str]",
        "high_missing_columns": "list[str]",
        "constant_columns": "list[str]",
        "repeated_entity_candidates": "list[dict[str, Any]]",
        "time_candidates": "list[dict[str, Any]]",
        "geo_coordinate_candidates": "list[dict[str, Any]]",
        "version": "str"
      },
      "nested": {
        "regression_target": ["count", "missing_count", "mean", "std", "min", "max", "median"],
        "repeated_entity_candidates[]": ["column", "unique_count", "unique_ratio", "repeated_rows", "max_rows_per_entity", "mean_rows_per_entity", "row_count", "missing_count", "identifier_likelihood"],
        "time_candidates[]": ["column", "parse_rate", "unique_count", "unique_ratio", "span_seconds", "monotonic_increasing", "name_tokens", "strong_name", "datetime_role"],
        "geo_coordinate_candidates[]": ["lat_column", "lon_column", "row_count", "lat_in_range_fraction", "lon_in_range_fraction"]
      }
    },
    "MetricPlan": {
      "path": "apps/api/app/engine/modeling/metric_planner.py",
      "symbol": "MetricPlan (dataclass); plan_metrics(profile, objective)",
      "version": "dclab.metric_plan.v1",
      "fields": {
        "primary_metric": "str",
        "secondary_metrics": "list[str]",
        "reason": "str",
        "version": "str"
      }
    },
    "HoldoutPlan": {
      "path": "apps/api/app/engine/modeling/holdout_planner.py",
      "symbol": "HoldoutPlan (dataclass); plan_holdout(frame, target=, task_type=)",
